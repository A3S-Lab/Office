+function write_ws_xml_sparse_data(ws, opts, idx, wb) {
+	var output = [], rows = ws['!rows'], range = safe_decode_range(ws['!ref']);
+	var cellsByRow = Object.create(null), rowIndexes = Object.create(null);
+	Object.keys(ws).forEach(function(ref) {
+		if(ref.charAt(0) === '!') return;
+		var position = decode_cell(ref);
+		if(position.r < range.s.r || position.r > range.e.r || position.c < range.s.c || position.c > range.e.c) return;
+		if(!cellsByRow[position.r]) cellsByRow[position.r] = [];
+		cellsByRow[position.r].push({ c: position.c, ref: ref });
+		rowIndexes[position.r] = true;
+	});
+	if(rows) Object.keys(rows).forEach(function(rowKey) {
+		var rowIndex = Number(rowKey);
+		if(Number.isSafeInteger(rowIndex) && rowIndex >= 0) rowIndexes[rowIndex] = true;
+	});
+	Object.keys(rowIndexes).map(Number).sort(function(left, right) { return left - right; }).forEach(function(R) {
+		var rowData = [], rowCells = cellsByRow[R] || [];
+		rowCells.sort(function(left, right) { return left.c - right.c; }).forEach(function(item) {
+			var cell = write_ws_xml_cell(ws[item.ref], item.ref, ws, opts, idx, wb);
+			if(cell != null) rowData.push(cell);
+		});
+		var row = rows && rows[R], params = { r: encode_row(R) };
+		if(row) {
+			if(row.hidden) params.hidden = 1;
+			var height = -1;
+			if(row.hpx) height = px2pt(row.hpx);
+			else if(row.hpt) height = row.hpt;
+			if(height > -1) { params.ht = height; params.customHeight = 1; }
+			if(row.level) params.outlineLevel = row.level;
+		}
+		if(rowData.length > 0 || row) output.push(writextag('row', rowData.join(""), params));
+	});
+	return output.join("");
+}
