suite "collaboration-playground-entry" {
    version = 1

    scenario "desktop-collaboration-entry" {
        name = "Open the visible real-time collaboration demo from the Playground"
        surface = "web"
        timeout_ms = 30000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "collaboration-capability-is-visible" {
            text = "多人实时协作"
        }

        expect "backend-guide-has-a-canonical-route" {
            visible = css("a[href$='/components/collaboration-server.html']")
        }

        click "open-collaboration-demo" {
            target = role("button", "体验实时评论")
        }

        expect "comment-mode-is-explicit" {
            text = "实时评论 · 2 人在线"
        }

        wait "two-participants-joined" {
            visible = css("button[aria-label='查看协作者，2 位协作者']")
        }

        wait "remote-caret-is-projected" {
            visible = css(".work-office-remote-caret[data-participant-id='playground-agent']")
        }

        click "open-participant-roster" {
            target = role("button", "查看协作者，2 位协作者")
        }

        expect "agent-is-listed" {
            text = "A3S Agent"
        }

        accessibility "desktop-collaboration-accessibility" {
            path = "evidence/collaboration-playground-desktop.json"
            interactive = true
        }

        console "desktop-console" {
            path = "diagnostics/collaboration-playground-desktop-console.json"
            clear = false
        }

        page_errors "desktop-errors" {
            path = "diagnostics/collaboration-playground-desktop-errors.json"
            clear = false
        }
    }

    scenario "compact-collaboration-entry" {
        name = "Keep the collaboration demo discoverable on a phone viewport"
        surface = "web"
        timeout_ms = 30000

        viewport "phone" {
            width = 390
            height = 844
            scale = 1
        }

        navigate "open-compact-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "compact-collaboration-capability-is-visible" {
            text = "多人实时协作"
        }

        expect "compact-backend-guide-is-visible" {
            visible = css("a[href$='/components/collaboration-server.html']")
        }

        click "open-compact-collaboration-demo" {
            target = role("button", "体验实时评论")
        }

        wait "compact-comment-mode-is-explicit" {
            visible = css("button[aria-label^='查看批注']")
        }

        wait "compact-participants-joined" {
            visible = css("button[aria-label='查看协作者，2 位协作者']")
        }

        wait "compact-remote-caret-is-projected" {
            visible = css(".work-office-remote-caret[data-participant-id='playground-agent']")
        }

        click "open-compact-participant-roster" {
            target = role("button", "查看协作者，2 位协作者")
        }

        expect "compact-agent-is-listed" {
            text = "A3S Agent"
        }

        accessibility "compact-collaboration-accessibility" {
            path = "evidence/collaboration-playground-compact.json"
            interactive = true
        }

        console "compact-console" {
            path = "diagnostics/collaboration-playground-compact-console.json"
            clear = false
        }

        page_errors "compact-errors" {
            path = "diagnostics/collaboration-playground-compact-errors.json"
            clear = false
        }
    }
}
