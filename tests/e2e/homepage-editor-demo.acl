suite "homepage-editor-demo" {
    version = 1

    scenario "desktop-editor-chapters" {
        name = "Show real editor captures for every Office editor"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1440
            height = 900
            scale = 1
        }

        navigate "open-product-home" {
            url = "http://127.0.0.1:4175/"
        }

        expect "hero-heading-is-visible" {
            visible = css("main.office-product-home h1#office-product-title")
        }

        expect "hero-heading-is-in-viewport" {
            in_viewport = css("main.office-product-home h1#office-product-title")
        }

        expect "surface-map-is-visible" {
            visible = css(".office-home-surface-map")
        }

        expect "hero-stack-uses-real-captures" {
            visible = css(".office-home-surface-map[data-real-editor-gallery='hero'] .office-home-screenshot-stack__card img[src*='editor-previews/document.png']")
        }

        expect "hero-stack-has-five-captures" {
            visible = css(".office-home-screenshot-stack__card:nth-child(5) img[src*='editor-previews/pdf.png']")
        }

        expect "chapter-preview-mode-is-explicit" {
            visible = css(".office-editor-chapters[data-editor-runtime='preview'][data-preview-kind='editor-chapters']")
        }

        expect "preview-boundary-is-visible" {
            visible = css("#office-editor-chapters-preview-note")
        }

        expect "live-editor-runtime-is-not-mounted" {
            visible = css("main.office-product-home:not(:has(.work-document-editor, .work-spreadsheet-editor, .work-presentation-editor, .work-pdf-viewer))")
        }

        expect "chapter-navigation-is-visible" {
            visible = css(".office-editor-chapters__index")
        }

        expect "chapter-progress-is-visible" {
            visible = css(".office-editor-chapters__progress[role='status']")
        }

        expect "chapter-recovery-path-is-discoverable" {
            visible = css(".office-editor-chapter__recovery summary")
        }

        expect "collaboration-path-is-discoverable" {
            visible = css(".docs-home-collaboration a[href*='collaboration']")
        }

        expect "collaboration-state-diagram-is-visible" {
            visible = css(".docs-home-collaboration__diagram")
        }

        expect "final-product-cta-is-discoverable" {
            visible = css(".docs-home-final .docs-home-action--primary")
        }

        expect "document-motion-preview-is-visible" {
            visible = css("[data-editor-chapter='document'] .office-motion-window[data-real-editor-screenshot='true'] img[src*='editor-previews/document.png']")
        }

        expect "markdown-motion-preview-is-visible" {
            visible = css("[data-editor-chapter='markdown'] .office-motion-window[data-real-editor-screenshot='true'] img[src*='editor-previews/markdown.png']")
        }

        expect "spreadsheet-motion-preview-is-visible" {
            visible = css("[data-editor-chapter='spreadsheet'] .office-motion-window[data-real-editor-screenshot='true'] img[src*='editor-previews/spreadsheet.png']")
        }

        expect "presentation-motion-preview-is-visible" {
            visible = css("[data-editor-chapter='presentation'] .office-motion-window[data-real-editor-screenshot='true'] img[src*='editor-previews/presentation.png']")
        }

        expect "pdf-motion-preview-is-visible" {
            visible = css("[data-editor-chapter='pdf'] .office-motion-window[data-real-editor-screenshot='true'] img[src*='editor-previews/pdf.png']")
        }

        wheel "desktop-to-chapter-controls" {
            delta_x = 0
            delta_y = 900
            modifiers = []
        }

        click "pause-previews" {
            target = css(".office-editor-chapters__motion-toggle")
        }

        expect "previews-are-paused" {
            visible = css(".office-editor-chapters[data-motion-paused='true'] .office-editor-chapters__motion-toggle[aria-pressed='true']")
        }

        click "resume-previews" {
            target = css(".office-editor-chapters__motion-toggle")
        }

        expect "previews-are-playing" {
            visible = css(".office-editor-chapters[data-motion-paused='false'] .office-editor-chapters__motion-toggle[aria-pressed='false']")
        }

        click "jump-to-markdown-chapter" {
            target = css(".office-editor-chapters__index a[href='#editor-chapter-markdown']")
        }

        expect "markdown-anchor-is-selected" {
            visible = css("#editor-chapter-markdown:target")
        }

        wait "markdown-chapter-scroll-settled" {
            text = "Markdown 章节已定位"
        }

        expect "markdown-chapter-is-addressable" {
            in_viewport = css("[data-editor-chapter='markdown']")
        }

        accessibility "desktop-editor-chapters-tree" {
            path = "evidence/homepage-editor-chapters-desktop.json"
            interactive = true
        }

        console "desktop-console" {
            path = "diagnostics/homepage-editor-chapters-desktop-console.json"
            clear = false
        }

        page_errors "desktop-errors" {
            path = "diagnostics/homepage-editor-chapters-desktop-errors.json"
            clear = false
        }
    }

    scenario "phone-editor-chapters" {
        name = "Keep the chapter index and motion previews usable on a phone"
        surface = "web"
        timeout_ms = 120000

        viewport "phone" {
            width = 390
            height = 844
            scale = 1
        }

        navigate "open-product-home-on-phone" {
            url = "http://127.0.0.1:4175/"
        }

        expect "phone-hero-heading-is-visible" {
            visible = css("main.office-product-home h1#office-product-title")
        }

        expect "phone-hero-heading-is-in-viewport" {
            in_viewport = css("main.office-product-home h1#office-product-title")
        }

        expect "phone-chapter-navigation-is-visible" {
            visible = css(".office-editor-chapters__index")
        }

        expect "phone-preview-mode-is-explicit" {
            visible = css(".office-editor-chapters[data-editor-runtime='preview']")
        }

        expect "phone-preview-boundary-is-visible" {
            visible = css("#office-editor-chapters-preview-note")
        }

        expect "phone-chapter-progress-is-visible" {
            visible = css(".office-editor-chapters__progress[role='status']")
        }

        expect "phone-live-editor-runtime-is-not-mounted" {
            visible = css("main.office-product-home:not(:has(.work-document-editor, .work-spreadsheet-editor, .work-presentation-editor, .work-pdf-viewer))")
        }

        expect "phone-chapter-recovery-path-is-discoverable" {
            visible = css(".office-editor-chapter__recovery summary")
        }

        expect "phone-collaboration-path-is-discoverable" {
            visible = css(".docs-home-collaboration a[href*='collaboration']")
        }

        expect "phone-final-product-cta-is-discoverable" {
            visible = css(".docs-home-final .docs-home-action--primary")
        }

        wheel "phone-to-chapter-index" {
            delta_x = 0
            delta_y = 1400
            modifiers = []
        }

        wheel "phone-index-to-pdf" {
            target = css(".office-editor-chapters__index")
            delta_x = 520
            delta_y = 0
            modifiers = []
        }

        click "phone-jump-to-pdf-chapter" {
            target = css(".office-editor-chapters__index a[href='#editor-chapter-pdf']")
        }

        expect "phone-pdf-anchor-is-selected" {
            visible = css("#editor-chapter-pdf:target")
        }

        wait "phone-pdf-chapter-is-visible" {
            text = "PDF 章节已定位"
        }

        expect "phone-pdf-chapter-is-addressable" {
            in_viewport = css("[data-editor-chapter='pdf']")
        }

        expect "phone-pdf-motion-preview-is-visible" {
            visible = css("[data-editor-chapter='pdf'] .office-motion-window")
        }

        wheel "phone-return-to-top" {
            delta_x = 0
            # Return to the top before moving to the chapter header. A single
            # large reverse gesture can stop at scrollY=0 while the chapter
            # controls are still below the hero on a compact viewport.
            delta_y = -5000
            modifiers = []
        }

        wheel "phone-top-to-motion-control" {
            delta_x = 0
            delta_y = 1400
            modifiers = []
        }

        expect "phone-motion-control-is-in-viewport" {
            in_viewport = css(".office-editor-chapters__motion-toggle")
        }

        focus "phone-focus-motion-control" {
            target = css(".office-editor-chapters__motion-toggle")
        }

        press "phone-pause-previews" {
            key = "Space"
        }

        wait "phone-pause-state-is-announced" {
            text = "播放预览"
        }

        expect "phone-previews-are-paused" {
            text = "播放预览"
        }

        accessibility "phone-editor-chapters-tree" {
            path = "evidence/homepage-editor-chapters-phone.json"
            interactive = true
        }

        console "phone-console" {
            path = "diagnostics/homepage-editor-chapters-phone-console.json"
            clear = false
        }

        page_errors "phone-errors" {
            path = "diagnostics/homepage-editor-chapters-phone-errors.json"
            clear = false
        }
    }
}
