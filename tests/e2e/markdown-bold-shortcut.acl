suite "office-markdown-bold-shortcut" {
    version = 1

    scenario "apply-markdown-bold-with-wps-ctrl-b" {
        name = "Apply Markdown bold with WPS Ctrl+B in source editing"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-markdown" {
            target = text("产品说明", true)
        }

        wait "markdown-ready" {
            visible = css(".work-markdown-editor .work-markdown-ribbon")
        }

        expect "bold-shortcut" {
            visible = css(".work-markdown-ribbon button[aria-label='加粗'][aria-keyshortcuts='Control+B Meta+B']")
        }

        expect "italic-shortcut" {
            visible = css(".work-markdown-ribbon button[aria-label='斜体'][aria-keyshortcuts='Control+I Meta+I']")
        }

        click "focus-markdown-source" {
            target = role("textbox", "Markdown 源码")
        }

        press "apply-bold" {
            key = "Control+b"
        }

        wait "bold-active" {
            visible = css(".work-markdown-ribbon button[aria-label='加粗'][aria-pressed='true']")
        }

        expect "bold-pressed" {
            visible = css(".work-markdown-ribbon button[aria-label='加粗'][aria-pressed='true']")
        }

        accessibility "markdown-bold-shortcut-accessibility" {
            path = "evidence/markdown-bold-shortcut-accessibility.json"
        }

        console "markdown-bold-shortcut-console" {
            path = "diagnostics/markdown-bold-shortcut-console.json"
        }

        page_errors "markdown-bold-shortcut-page-errors" {
            path = "diagnostics/markdown-bold-shortcut-page-errors.json"
        }
    }
}
