suite "office-markdown-daily-loop" {
    version = 1

    scenario "write-format-table-save-reopen" {
        name = "Write, bold, and add a GFM table in Markdown, then reopen the saved file"
        surface = "web"
        timeout_ms = 300000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-markdown" {
            target = text("产品说明", true)
        }

        wait "markdown-ready" {
            visible = css(".work-markdown-editor .work-markdown-ribbon")
        }

        fill "write-heading" {
            target = css(".work-markdown-pane.source textarea")
            value = "# MDDAILY heading"
        }

        press "heading-break-1" {
            key = "Enter"
        }

        press "heading-break-2" {
            key = "Enter"
        }

        type "write-body" {
            target = css(".work-markdown-pane.source textarea")
            value = "MDDAILY alpha"
        }

        press "select-body-line" {
            key = "Shift+Home"
        }

        press "bold-body-line" {
            key = "Control+b"
        }

        press "move-to-body-end" {
            key = "End"
        }

        press "body-break-1" {
            key = "Enter"
        }

        press "body-break-2" {
            key = "Enter"
        }

        type "write-table" {
            target = css(".work-markdown-pane.source textarea")
            value = "| Item | Owner |\n| --- | --- |\n| MDDAILY row | Ops |"
        }

        wait "preview-bold" {
            visible = css(".work-markdown-pane.visual strong")
        }

        expect "preview-bold-text" {
            target = css(".work-markdown-pane.visual strong")
            rendered_text = "MDDAILY alpha"
        }

        wait "preview-table" {
            visible = css(".work-markdown-pane.visual table")
        }

        click "save-markdown" {
            target = role("button", "导出")
        }

        wait "markdown-downloaded" {
            text = "产品说明.md 已下载"
        }

        wait "reopen-exported-file" {
            visible = css("button[aria-label='重新打开已导出文件']")
        }

        click "reopen-saved-markdown" {
            target = role("button", "重新打开已导出文件")
        }

        wait "saved-markdown-opened" {
            text = "产品说明.md 已打开"
        }

        wait "reopened-preview" {
            visible = css(".work-markdown-pane.visual table")
        }

        expect "reopened-heading" {
            target = css(".work-markdown-pane.visual h1")
            rendered_text = "MDDAILY heading"
        }

        expect "reopened-bold" {
            target = css(".work-markdown-pane.visual strong")
            rendered_text = "MDDAILY alpha"
        }

        expect "reopened-table-cell" {
            text = "MDDAILY row"
        }

        accessibility "markdown-daily-loop-accessibility" {
            path = "evidence/markdown-daily-loop-accessibility.json"
            interactive = true
        }

        console "markdown-daily-loop-console" {
            path = "diagnostics/markdown-daily-loop-console.json"
            clear = false
        }

        page_errors "markdown-daily-loop-page-errors" {
            path = "diagnostics/markdown-daily-loop-page-errors.json"
            clear = false
        }
    }
}
