suite "office-markdown-link-shortcut" {
    version = 1

    scenario "open-markdown-link-dialog-with-wps-ctrl-k" {
        name = "Open the Markdown link dialog with WPS Ctrl+K"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-markdown" {
            target = text("产品说明", true)
        }

        wait "markdown-ready" {
            visible = css(".work-markdown-editor .work-markdown-ribbon")
        }

        click "open-insert-tab" {
            target = role("tab", "插入")
        }

        expect "link-shortcut" {
            visible = css(".work-markdown-ribbon button[aria-label='添加链接'][aria-keyshortcuts='Control+K Meta+K']")
        }

        click "focus-markdown-source" {
            target = role("textbox", "Markdown 源码")
        }

        press "open-link-dialog" {
            key = "Control+k"
        }

        wait "link-dialog-open" {
            visible = css(".work-markdown-insert-dialog[role='dialog']")
        }

        expect "link-dialog-visible" {
            visible = css(".work-markdown-insert-dialog[role='dialog']")
        }

        accessibility "markdown-link-shortcut-accessibility" {
            path = "evidence/markdown-link-shortcut-accessibility.json"
        }

        console "markdown-link-shortcut-console" {
            path = "diagnostics/markdown-link-shortcut-console.json"
        }

        page_errors "markdown-link-shortcut-page-errors" {
            path = "diagnostics/markdown-link-shortcut-page-errors.json"
        }
    }
}
