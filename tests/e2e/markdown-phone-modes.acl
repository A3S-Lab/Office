suite "office-markdown-phone-modes" {
    version = 1

    scenario "edit-and-switch-markdown-modes-on-phone" {
        name = "Edit Markdown and switch between its phone view modes"
        surface = "web"
        timeout_ms = 60000

        viewport "phone" {
            width = 390
            height = 844
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/?e2e=markdown-phone-modes"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        expect "phone-sidebar-starts-closed" {
            visible = css("button[aria-label='展开办公侧边栏']")
        }

        focus "focus-markdown-template" {
            target = css(".playground-template-card.markdown")
        }

        click "create-markdown" {
            target = css(".playground-template-card.markdown")
        }

        wait "markdown-loaded" {
            visible = css(".work-markdown-editor")
        }

        expect "default-phone-split-view" {
            visible = css(".work-markdown-workspace.split")
        }

        expect "phone-split-starts-with-source" {
            visible = css(".work-markdown-compact-switch button[aria-label='显示源码窗格'][aria-pressed='true']")
        }

        click "show-phone-preview" {
            target = role("button", "显示预览窗格")
        }

        expect "phone-preview-uses-workspace" {
            visible = css(".work-markdown-workspace.split[data-compact-pane='preview'] .work-markdown-pane.visual")
        }

        click "return-to-phone-source" {
            target = role("button", "显示源码窗格")
        }

        fill "write-markdown-source" {
            target = css(".work-markdown-pane.source textarea")
            value = "# 手机工作流"
        }

        press "insert-markdown-line-break-1" {
            key = "Enter"
        }

        type "append-markdown-check-item" {
            target = css(".work-markdown-pane.source textarea")
            value = "- [x] 源码编辑"
        }

        press "insert-markdown-line-break-2" {
            key = "Enter"
        }

        type "append-markdown-preview-item" {
            target = css(".work-markdown-pane.source textarea")
            value = "- [ ] 预览同步"
        }

        click "show-synchronized-preview" {
            target = role("button", "显示预览窗格")
        }

        wait "preview-synchronized" {
            text = "预览同步"
        }

        click "restore-phone-source" {
            target = role("button", "显示源码窗格")
        }

        click "open-view-tab" {
            target = role("tab", "视图")
        }

        expect "visual-mode-is-unambiguous" {
            visible = css("button[aria-label='可视化编辑']")
        }

        expect "source-mode-is-unambiguous" {
            visible = css("button[aria-label='源码编辑']")
        }

        expect "split-mode-is-unambiguous" {
            visible = css("button[aria-label='分屏编辑'][aria-pressed='true']")
        }

        click "use-source-mode" {
            target = role("button", "源码编辑")
        }

        expect "source-only-workspace" {
            visible = css(".work-markdown-workspace.source .work-markdown-pane.source")
        }

        click "use-visual-mode" {
            target = role("button", "可视化编辑")
        }

        expect "visual-editor-workspace" {
            visible = css(".work-markdown-workspace.visual [aria-label='Markdown 编辑区']")
        }

        click "restore-split-mode" {
            target = role("button", "分屏编辑")
        }

        expect "split-workspace-restored" {
            visible = css(".work-markdown-workspace.split[data-compact-pane='source'] .work-markdown-pane.source")
        }

        click "show-final-phone-preview" {
            target = role("button", "显示预览窗格")
        }

        expect "final-preview-selected" {
            visible = css(".work-markdown-workspace.split[data-compact-pane='preview'] button[aria-label='显示预览窗格'][aria-pressed='true']")
        }

        screenshot "phone-markdown-modes" {
            path = "screenshots/markdown-phone-modes.png"
        }

        accessibility "mode-semantics" {
            path = "evidence/mode-semantics.json"
            interactive = true
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
