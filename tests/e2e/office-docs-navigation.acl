suite "office-docs-navigation" {
    version = 1

    scenario "open-docs-and-return-to-playground" {
        name = "Open the dedicated documentation center and return to the Playground"
        surface = "web"
        timeout_ms = 30000

        viewport "responsive-navigation" {
            width = 1200
            height = 900
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/"
        }

        expect "playground-is-home" {
            text = "我的文档"
        }

        click "open-documentation" {
            target = text("文档", true)
        }

        wait "documentation-route" {
            url = "http://127.0.0.1:4175/docs/"
        }

        expect "documentation-center-ready" {
            text = "A3S Office 文档"
        }

        expect "documentation-defaults-to-chinese" {
            visible = css("html[lang=zh]")
        }

        expect "documentation-search-ready" {
            visible = css(".rp-search-button, .rp-search-button--mobile")
        }

        expect "documentation-tree-ready" {
            visible = css(".rp-doc-layout__sidebar")
        }

        expect "editor-reference-is-managed" {
            text = "DocumentEditor"
        }

        screenshot "documentation-center" {
            path = "screenshots/documentation-center.png"
        }

        click "open-document-reference" {
            target = css(".rp-doc-layout__sidebar a[href$='/components/document.html']")
        }

        wait "latest-document-route" {
            url = "http://127.0.0.1:4175/docs/components/document.html"
        }

        viewport "compact-version-navigation" {
            width = 700
            height = 900
        }

        snapshot "observe-compact-version-navigation" {
            interactive = true
        }

        click "open-responsive-navigation" {
            target = css(".rp-nav-hamburger__sm")
        }

        snapshot "observe-responsive-navigation" {
            interactive = true
        }

        expect "responsive-navigation-open" {
            visible = css(".rp-nav-screen--open")
        }

        click "open-version-menu" {
            target = css(".rp-nav-screen--open .rp-nav-screen-versions")
        }

        snapshot "observe-version-menu" {
            interactive = true
        }

        expect "version-0-1-0-visible" {
            visible = css(".rp-nav-screen--open .rp-nav-screen-versions-group a[href*='/0.1.0/components/document.html']")
        }

        click "select-version-0-1-0" {
            target = css(".rp-nav-screen--open .rp-nav-screen-versions-group a[href*='/0.1.0/components/document.html']")
        }

        wait "versioned-document-route" {
            url = "http://127.0.0.1:4175/docs/0.1.0/components/document.html"
        }

        expect "versioned-document-ready" {
            text = "自定义选区菜单"
        }

        click "reopen-responsive-navigation" {
            target = css(".rp-nav-hamburger__sm")
        }

        snapshot "observe-responsive-navigation-reopened" {
            interactive = true
        }

        expect "responsive-navigation-reopened" {
            visible = css(".rp-nav-screen--open")
        }

        click "open-language-menu" {
            target = css(".rp-nav-screen--open .rp-nav-screen-langs")
        }

        snapshot "observe-language-menu" {
            interactive = true
        }

        expect "english-language-visible" {
            visible = css(".rp-nav-screen--open .rp-nav-screen-langs-group a[lang='en']")
        }

        click "select-english" {
            target = css(".rp-nav-screen--open .rp-nav-screen-langs-group a[lang='en']")
        }

        wait "english-versioned-document-route" {
            url = "http://127.0.0.1:4175/docs/0.1.0/en/components/document.html"
        }

        expect "english-document-ready" {
            text = "Host-defined selection menu"
        }

        expect "documentation-language-is-english" {
            visible = css("html[lang=en]")
        }

        click "reopen-responsive-navigation-for-latest" {
            target = css(".rp-nav-hamburger__sm")
        }

        snapshot "observe-responsive-navigation-for-latest" {
            interactive = true
        }

        expect "responsive-navigation-open-for-latest" {
            visible = css(".rp-nav-screen--open")
        }

        click "open-latest-menu" {
            target = css(".rp-nav-screen--open .rp-nav-screen-versions")
        }

        snapshot "observe-latest-menu" {
            interactive = true
        }

        expect "latest-version-visible" {
            visible = css(".rp-nav-screen--open .rp-nav-screen-versions-group a[href$='/en/components/document.html']")
        }

        click "select-latest" {
            target = css(".rp-nav-screen--open .rp-nav-screen-versions-group a[href$='/en/components/document.html']")
        }

        wait "latest-english-document-route" {
            url = "http://127.0.0.1:4175/docs/en/components/document.html"
        }

        click "return-to-playground" {
            target = css(".office-docs-playground-link")
        }

        wait "playground-route-restored" {
            url = "http://127.0.0.1:4175/"
        }

        expect "playground-restored" {
            text = "我的文档"
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
