suite "office-docs-navigation" {
    version = 1

    scenario "discover-collaboration-backend" {
        name = "Discover the collaboration backend from the documentation center"
        surface = "web"
        timeout_ms = 90000

        viewport "desktop-documentation" {
            width = 1440
            height = 900
            scale = 1
        }

        navigate "open-documentation-center" {
            url = "http://127.0.0.1:4175/docs/"
        }

        expect "documentation-center-ready" {
            text = "从嵌入编辑器到多人实时协作"
        }

        expect "documentation-defaults-to-chinese" {
            visible = css("html[lang=zh]")
        }

        expect "documentation-search-ready" {
            visible = css(".rp-search-button")
        }

        expect "primary-navigation-matches-a3s-ui-shell" {
            visible = css(".rp-nav__left .rp-nav-menu--left .rp-nav-menu__item__container")
        }

        expect "utility-navigation-follows-search" {
            visible = css(".rp-nav__right .rp-search-button--mobile + .rp-nav-menu--right")
        }

        expect "shared-a3s-brand-is-visible" {
            visible = css(".rp-nav__title__logo img[src$='/a3s-logo.png']")
        }

        expect "documentation-theme-control-is-visible" {
            visible = css(".rp-nav__others .rp-switch-appearance[role='button'][aria-label='切换主题']")
        }

        expect "documentation-tree-ready" {
            visible = css(".rp-doc-layout__sidebar")
        }

        expect "editor-reference-is-managed" {
            text = "DocumentEditor"
        }

        expect "workflow-navigation-is-visible" {
            visible = css("main .docs-home-flow")
        }

        expect "collaboration-stage-is-emphasized" {
            visible = css("main .docs-home-stage--collaborate")
        }

        expect "collaboration-entry-is-prominent" {
            visible = css("main .docs-home-stage--collaborate a[href$='/components/collaboration.html']")
        }

        expect "collaboration-backend-entry-is-prominent" {
            visible = css("main .docs-home-stage--collaborate a[href$='/components/collaboration-server.html']")
        }

        navigate "open-collaboration-guide" {
            url = "http://127.0.0.1:4175/docs/components/collaboration.html"
        }

        expect "collaboration-guide-ready" {
            text = "从两台浏览器开始"
        }

        expect "collaboration-reconnect-is-documented" {
            text = "断线、离线与收敛"
        }

        expect "collaboration-authorization-is-documented" {
            text = "权限与安全边界"
        }

        expect "document-suggestion-mode-is-documented" {
            text = "使用 suggest 模式提出修订"
        }

        expect "collaboration-server-entry-is-visible" {
            visible = css("main a[href$='/components/collaboration-server.html']")
        }

        navigate "open-collaboration-server-guide" {
            url = "http://127.0.0.1:4175/docs/components/collaboration-server.html"
        }

        expect "collaboration-server-runbook-is-complete" {
            text = "启动服务"
        }

        expect "collaboration-server-ticket-flow-is-documented" {
            text = "签发房间票据"
        }

        expect "native-agent-boundary-is-documented" {
            text = "接入原生智能体"
        }

        expect "native-agent-presence-is-documented" {
            text = "outbound-awareness"
        }

        expect "suggestion-semantic-authorization-is-documented" {
            text = "Document suggest"
        }

        console "collaboration-discovery-console" {
            path = "diagnostics/collaboration-discovery-console.json"
            clear = false
        }

        page_errors "collaboration-discovery-errors" {
            path = "diagnostics/collaboration-discovery-page-errors.json"
            clear = false
        }
    }

    scenario "verify-collaboration-server-rendering" {
        name = "Verify the collaboration backend guide renderer and bounded evidence"
        surface = "web"
        timeout_ms = 90000

        viewport "collaboration-server-documentation" {
            width = 1200
            height = 900
            scale = 1
        }

        navigate "open-collaboration-server-reference" {
            url = "http://127.0.0.1:4175/docs/components/collaboration-server.html"
        }

        expect "collaboration-server-reference-ready" {
            text = "A3S Boot 实时协作后端"
        }

        expect "reference-table-uses-document-renderer" {
            visible = css("main .rp-doc table")
        }

        expect "inline-code-uses-document-renderer" {
            visible = css("main .rp-doc p code")
        }

        expect "typescript-code-is-highlighted" {
            visible = css("main .rp-codeblock.language-ts .shiki [style*='--shiki-token-keyword']")
        }

        focus "focus-typescript-code-control" {
            target = css("main .rp-codeblock.language-ts .rp-code-wrap-button")
        }

        expect "code-wrap-control-is-available" {
            visible = css("main .rp-codeblock.language-ts .rp-code-wrap-button[aria-label='切换代码换行']")
        }

        expect "code-copy-control-is-available" {
            visible = css("main .rp-codeblock.language-ts .rp-code-copy-button[title='复制代码']")
        }

        screenshot "collaboration-server-guide" {
            path = "screenshots/collaboration-server-guide.png"
        }

        accessibility "collaboration-server-accessibility" {
            path = "evidence/collaboration-server.json"
            interactive = true
        }

        console "collaboration-rendering-console" {
            path = "diagnostics/collaboration-rendering-console.json"
            clear = false
        }

        page_errors "collaboration-rendering-errors" {
            path = "diagnostics/collaboration-rendering-page-errors.json"
            clear = false
        }
    }

    scenario "verify-large-document-performance-evidence" {
        name = "Verify the reproducible 100k Document performance reference"
        surface = "web"
        timeout_ms = 90000

        viewport "desktop-performance-reference" {
            width = 1440
            height = 900
            scale = 1
        }

        navigate "open-document-performance-reference" {
            url = "http://127.0.0.1:4175/docs/en/components/document.html"
        }

        expect "performance-reference-ready" {
            text = "Large-document performance"
        }

        expect "text-fixture-is-quantified" {
            text = "100,000 text paragraphs"
        }

        expect "table-fixture-is-quantified" {
            text = "100,000 table rows"
        }

        expect "scroll-result-is-quantified" {
            text = "120.0 FPS"
        }

        expect "benchmark-command-is-published" {
            text = "bun run performance:large-documents"
        }

        expect "full-methodology-is-linked" {
            visible = css("main a[href$='/en/browser-editor-architecture.html#current-100000-unit-evidence']")
        }

        console "performance-reference-console" {
            path = "diagnostics/performance-reference-console.json"
            clear = false
        }

        page_errors "performance-reference-errors" {
            path = "diagnostics/performance-reference-page-errors.json"
            clear = false
        }
    }

    scenario "scan-documentation-center-on-phone" {
        name = "Scan the documentation workflow and collaboration path on a phone"
        surface = "web"
        timeout_ms = 90000

        viewport "phone-documentation" {
            width = 390
            height = 844
            scale = 1
        }

        navigate "open-phone-documentation-center" {
            url = "http://127.0.0.1:4175/docs/"
        }

        expect "phone-documentation-hero-is-visible" {
            visible = css("main .docs-home-hero")
        }

        expect "phone-navigation-has-an-accessible-trigger" {
            visible = css("button.rp-nav-hamburger[aria-label='打开导航']")
        }

        expect "phone-primary-action-is-visible" {
            visible = css("main .docs-home-action--primary[href$='/guide/index.html']")
        }

        expect "phone-workflow-is-readable" {
            visible = css("main .docs-home-flow")
        }

        expect "phone-collaboration-is-discoverable" {
            visible = css("main .docs-home-stage--collaborate a[href$='/components/collaboration.html']")
        }

        expect "phone-backend-guide-is-discoverable" {
            visible = css("main .docs-home-stage--collaborate a[href$='/components/collaboration-server.html']")
        }

        screenshot "phone-documentation-center" {
            path = "screenshots/documentation-center-phone.png"
        }

        accessibility "phone-documentation-accessibility" {
            path = "evidence/documentation-center-phone.json"
            interactive = true
        }

        console "phone-documentation-console" {
            path = "diagnostics/documentation-center-phone-console.json"
            clear = false
        }

        page_errors "phone-documentation-errors" {
            path = "diagnostics/documentation-center-phone-errors.json"
            clear = false
        }
    }

    scenario "switch-desktop-documentation-version" {
        name = "Switch the desktop Document reference from latest to 0.1.0"
        surface = "web"
        timeout_ms = 90000

        viewport "desktop-version-navigation" {
            width = 1440
            height = 900
            scale = 1
        }

        navigate "open-latest-document-reference" {
            url = "http://127.0.0.1:4175/docs/components/document.html"
        }

        wait "latest-document-reference-hydrated" {
            load = "networkidle"
        }

        expect "latest-document-reference-ready" {
            text = "DocumentEditor"
        }

        expect "desktop-version-controls-visible" {
            visible = css(".rp-nav__others")
        }

        click "open-version-menu" {
            target = css(".rp-nav__others .rp-nav-menu__item:has(a[aria-label='0.1.0']) > .rp-nav-menu__item__container")
        }

        snapshot "observe-version-menu" {
            interactive = true
        }

        expect "version-0-1-0-visible" {
            visible = css(".rp-hover-group a[aria-label='0.1.0'][href='/docs/0.1.0/components/document']")
        }

        click "select-version-0-1-0" {
            target = css(".rp-hover-group a[aria-label='0.1.0'][href='/docs/0.1.0/components/document']")
        }

        wait "versioned-document-route" {
            url = "http://127.0.0.1:4175/docs/0.1.0/components/document.html"
        }

        expect "versioned-document-ready" {
            text = "自定义选区菜单"
        }

        console "desktop-version-console" {
            path = "diagnostics/desktop-version-console.json"
            clear = false
        }

        page_errors "desktop-version-errors" {
            path = "diagnostics/desktop-version-page-errors.json"
            clear = false
        }
    }

    scenario "switch-compact-language-and-latest" {
        name = "Switch a compact versioned Document reference to English and back to latest"
        surface = "web"
        timeout_ms = 90000

        viewport "compact-documentation-navigation" {
            width = 700
            height = 900
            scale = 1
        }

        navigate "open-versioned-document-reference" {
            url = "http://127.0.0.1:4175/docs/0.1.0/components/document.html"
        }

        expect "versioned-document-reference-ready" {
            text = "自定义选区菜单"
        }

        click "open-responsive-navigation" {
            target = css(".rp-nav-hamburger__sm")
        }

        expect "responsive-navigation-open" {
            visible = css(".rp-nav-screen--open")
        }

        click "open-language-menu" {
            target = css(".rp-nav-screen--open .rp-nav-screen-langs")
        }

        snapshot "observe-language-menu" {
            interactive = true
        }

        expect "english-language-visible" {
            visible = css(".rp-nav-screen--open .rp-nav-screen-langs-group a[lang='en']")
        }

        press "focus-english-language" {
            key = "Tab"
        }

        press "select-english" {
            key = "Enter"
        }

        wait "english-versioned-document-route" {
            url = "http://127.0.0.1:4175/docs/0.1.0/en/components/document.html"
        }

        expect "english-document-ready" {
            text = "Host-defined selection menu"
        }

        expect "documentation-language-is-english" {
            visible = css("html[lang=en]")
        }

        click "reopen-responsive-navigation" {
            target = css(".rp-nav-hamburger__sm")
        }

        expect "responsive-navigation-open-for-latest" {
            visible = css(".rp-nav-screen--open")
        }

        click "open-latest-menu" {
            target = css(".rp-nav-screen--open .rp-nav-screen-versions")
        }

        snapshot "observe-latest-menu" {
            interactive = true
        }

        expect "latest-version-visible" {
            visible = css(".rp-nav-screen--open .rp-nav-screen-versions-group a[href='/docs/en/components/document.html']")
        }

        click "select-latest" {
            target = css(".rp-nav-screen--open .rp-nav-screen-versions-group a[href='/docs/en/components/document.html']")
        }

        wait "latest-english-document-route" {
            url = "http://127.0.0.1:4175/docs/en/components/document.html"
        }

        expect "latest-english-document-ready" {
            text = "DocumentEditor"
        }

        console "compact-navigation-console" {
            path = "diagnostics/compact-navigation-console.json"
            clear = false
        }

        page_errors "compact-navigation-errors" {
            path = "diagnostics/compact-navigation-page-errors.json"
            clear = false
        }
    }

    scenario "open-frozen-collaboration-server-release" {
        name = "Open the frozen 0.11.0 collaboration backend guide in both languages"
        surface = "web"
        timeout_ms = 90000

        viewport "release-documentation" {
            width = 1440
            height = 900
            scale = 1
        }

        navigate "open-chinese-release-homepage" {
            url = "http://127.0.0.1:4175/docs/0.11.0/index.html"
        }

        wait "release-homepage-hydrated" {
            load = "networkidle"
        }

        expect "release-collaboration-action-uses-html-route" {
            visible = css(".docs-home-action[href='./components/collaboration.html']")
        }

        click "open-collaboration-from-release-homepage" {
            target = css(".docs-home-action[href='./components/collaboration.html']")
        }

        wait "release-collaboration-route" {
            url = "http://127.0.0.1:4175/docs/0.11.0/components/collaboration.html"
        }

        expect "release-collaboration-guide-ready" {
            text = "多人实时协作"
        }

        navigate "open-chinese-collaboration-server-release" {
            url = "http://127.0.0.1:4175/docs/0.11.0/components/collaboration-server.html"
        }

        expect "chinese-collaboration-server-release-ready" {
            text = "A3S Boot 实时协作后端"
        }

        expect "chinese-runbook-is-frozen" {
            text = "启动服务"
        }

        expect "native-presence-runbook-is-frozen" {
            text = "outbound-awareness"
        }

        expect "formatting-revision-runbook-is-frozen" {
            text = "w:rPrChange"
        }

        expect "paragraph-formatting-revision-runbook-is-frozen" {
            text = "w:pPrChange"
        }

        expect "release-version-control-is-visible" {
            visible = css(".rp-nav__others .rp-nav-menu__item:has(a[aria-label='0.11.0']) > .rp-nav-menu__item__container")
        }

        navigate "open-english-collaboration-server-release" {
            url = "http://127.0.0.1:4175/docs/0.11.0/en/components/collaboration-server.html"
        }

        expect "english-collaboration-server-release-ready" {
            text = "A3S Boot collaboration server"
        }

        expect "english-ticket-runbook-is-frozen" {
            text = "Issue a room ticket"
        }

        expect "frozen-documentation-language-is-english" {
            visible = css("html[lang=en]")
        }

        screenshot "english-collaboration-server-release" {
            path = "screenshots/collaboration-server-0.11.0-en.png"
        }

        console "release-browser-console" {
            path = "diagnostics/release-console.json"
            clear = false
        }

        page_errors "release-browser-errors" {
            path = "diagnostics/release-page-errors.json"
            clear = false
        }
    }
}
