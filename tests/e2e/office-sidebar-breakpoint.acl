suite "office-sidebar-responsive-breakpoint" {
    version = 1

    scenario "preserve-sidebar-preferences-across-breakpoints" {
        name = "Keep the persistent Office sidebar out of the phone workspace"
        surface = "web"
        timeout_ms = 30000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "persistent-sidebar-is-ready" {
            visible = css(".playground-site.sidebar-visible .playground-sidebar:not([role='dialog'])")
        }

        focus "keep-search-context" {
            target = css("input[placeholder='搜索文件']")
        }

        viewport "phone" {
            width = 390
            height = 700
            scale = 1
        }

        expect "phone-sidebar-is-closed" {
            visible = css(".playground-site:not(.sidebar-visible) button[aria-label='展开办公侧边栏']")
        }

        expect "phone-workspace-is-interactive" {
            visible = css(".playground-main-pane:not([inert])")
        }

        focus "restore-phone-search-focus" {
            target = css("input[placeholder='搜索文件']")
        }

        expect "search-focus-is-restored" {
            focused = css("input[placeholder='搜索文件']")
        }

        screenshot "phone-workspace" {
            path = "screenshots/office-sidebar-phone-breakpoint.png"
        }

        accessibility "phone-workspace-accessibility" {
            path = "evidence/office-sidebar-phone-breakpoint.json"
            interactive = true
        }

        viewport "restore-desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        expect "persistent-sidebar-preference-is-restored" {
            visible = css(".playground-site.sidebar-visible .playground-sidebar:not([role='dialog'])")
        }

        focus "restore-desktop-search-focus" {
            target = css("input[placeholder='搜索文件']")
        }

        expect "desktop-search-focus-is-restored" {
            focused = css("input[placeholder='搜索文件']")
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
