suite "playground-template-discoverability" {
    version = 1

    scenario "open-playground-feature-templates" {
        name = "Open feature examples from the public Playground template grid"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground-home" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "template-grid-is-visible" {
            visible = css(".playground-template-section[aria-labelledby='playground-create-title']")
        }

        expect "entrance-exit-animation-entry-is-visible" {
            visible = css("button[data-template-id='animated-deck']")
        }

        expect "document-comparison-entry-is-visible" {
            visible = css("button[data-template-id='document-comparison']")
        }

        expect "table-of-contents-entry-is-visible" {
            visible = css("button[data-template-id='table-of-contents']")
        }

        expect "document-index-entry-is-visible" {
            visible = css("button[data-template-id='document-index']")
        }

        expect "character-shading-entry-is-visible" {
            visible = css("button[data-template-id='run-shading']")
        }

        expect "proofing-language-entry-is-visible" {
            visible = css("button[data-template-id='proofing-languages']")
        }

        expect "data-validation-entry-is-visible" {
            visible = css("button[data-template-id='data-validation']")
        }

        expect "conditional-format-entry-is-visible" {
            visible = css("button[data-template-id='conditional-format']")
        }

        expect "structured-reference-entry-is-visible" {
            visible = css("button[data-template-id='structured-references']")
        }

        expect "structured-reference-calculated-column-fill-is-described" {
            text = "插入行自动填充"
        }

        focus "focus-entrance-exit-animations" {
            target = css("button[data-template-id='animated-deck']")
        }

        click "open-entrance-exit-animations" {
            target = css("button[data-template-id='animated-deck']")
        }

        wait "entrance-exit-animation-presentation-is-ready" {
            text = "让对象按叙事顺序登场与退场"
        }

        expect "entrance-exit-animation-title-is-visible" {
            visible = css("input[aria-label='文件名'][value='进入与退出动画示例']")
        }

        navigate "return-to-playground-home-after-entrance-exit-animations" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-document-comparison" {
            target = css("button[data-template-id='document-comparison']")
        }

        click "open-document-comparison" {
            target = css("button[data-template-id='document-comparison']")
        }

        wait "document-comparison-is-ready" {
            visible = css(".work-document-editable .ProseMirror[data-pagination-state='ready']")
        }

        expect "document-comparison-title-is-visible" {
            visible = css("input[aria-label='文件名'][value='文档比较示例']")
        }

        navigate "return-to-playground-home-after-document-comparison" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-table-of-contents" {
            target = css("button[data-template-id='table-of-contents']")
        }

        click "open-table-of-contents" {
            target = css("button[data-template-id='table-of-contents']")
        }

        wait "table-of-contents-document-is-ready" {
            visible = css(".work-document-editable .ProseMirror[data-pagination-state='ready']")
        }

        expect "table-of-contents-title-is-visible" {
            visible = css("input[aria-label='文件名'][value='可更新目录示例']")
        }

        expect "typed-table-of-contents-is-visible" {
            visible = css(".work-document-table-of-contents[data-toc-leader='dot'][data-toc-hyperlinks='true']")
        }

        navigate "return-to-playground-home-after-table-of-contents" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-document-index" {
            target = css("button[data-template-id='document-index']")
        }

        click "open-document-index" {
            target = css("button[data-template-id='document-index']")
        }

        wait "document-index-document-is-ready" {
            visible = css(".work-document-editable .ProseMirror[data-pagination-state='ready']")
        }

        expect "document-index-title-is-visible" {
            visible = css("input[aria-label='文件名'][value='原生索引示例']")
        }

        expect "typed-document-index-is-visible" {
            visible = css(".work-document-index[data-index-columns='2'][data-index-leader='dot']")
        }

        navigate "return-to-playground-home-after-document-index" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-character-shading" {
            target = css("button[data-template-id='run-shading']")
        }

        click "open-character-shading" {
            target = css("button[data-template-id='run-shading']")
        }

        wait "character-shading-document-is-ready" {
            visible = css(".work-document-editable .ProseMirror[data-pagination-state='ready']")
        }

        expect "character-shading-title-is-visible" {
            visible = css("input[aria-label='文件名'][value='字符底纹示例']")
        }

        navigate "return-to-playground-home-after-shading" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-proofing-languages" {
            target = css("button[data-template-id='proofing-languages']")
        }

        click "open-proofing-languages" {
            target = css("button[data-template-id='proofing-languages']")
        }

        wait "proofing-language-document-is-ready" {
            visible = css(".work-document-editable .ProseMirror[data-pagination-state='ready']")
        }

        expect "proofing-language-title-is-visible" {
            visible = css("input[aria-label='文件名'][value='校对语言示例']")
        }

        navigate "return-to-playground-home-after-proofing" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-data-validation" {
            target = css("button[data-template-id='data-validation']")
        }

        click "open-data-validation" {
            target = css("button[data-template-id='data-validation']")
        }

        wait "data-validation-workbook-is-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "data-validation-title-is-visible" {
            visible = css("input[aria-label='文件名'][value='数据验证示例']")
        }

        navigate "return-to-playground-home-after-data-validation" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-structured-references" {
            target = css("button[data-template-id='structured-references']")
        }

        click "open-structured-references" {
            target = css("button[data-template-id='structured-references']")
        }

        wait "structured-reference-workbook-is-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "structured-reference-title-is-visible" {
            visible = css("input[aria-label='文件名'][value='结构化引用示例']")
        }

        accessibility "template-grid-accessibility" {
            path = "evidence/playground-templates.json"
            interactive = true
        }

        console "template-grid-console" {
            path = "diagnostics/playground-template-console.json"
            clear = false
        }

        page_errors "template-grid-errors" {
            path = "diagnostics/playground-template-errors.json"
            clear = false
        }
    }

    scenario "follow-latest-documentation-links" {
        name = "Follow latest capability links from the documentation index"
        surface = "web"
        timeout_ms = 90000

        viewport "documentation-desktop" {
            width = 1440
            height = 900
            scale = 1
        }

        navigate "open-documentation-home" {
            url = "http://127.0.0.1:4175/docs/"
        }

        expect "latest-documentation-links-are-visible" {
            text = "main 更新内容"
        }

        expect "latest-documentation-covers-writer" {
            visible = css("main .rp-doc a[href*='components/document.html#']")
        }

        navigate "open-entrance-exit-animation-documentation" {
            url = "http://127.0.0.1:4175/docs/components/presentation.html"
        }

        wait "entrance-exit-animation-documentation-is-open" {
            text = "一个对象最多拥有一条可编辑进入动画和一条可编辑退出"
        }

        expect "entrance-exit-animation-is-documented" {
            visible = css("main h2[id='进入与退出动画']")
        }

        navigate "return-to-documentation-home-after-entrance-exit-animation" {
            url = "http://127.0.0.1:4175/docs/"
        }

        navigate "open-document-comparison-documentation" {
            url = "http://127.0.0.1:4175/docs/components/document.html"
        }

        wait "document-comparison-documentation-is-open" {
            text = "比较会把当前受控文档"
        }

        expect "document-comparison-is-documented" {
            visible = css("main h2[id='文档比较与合并']")
        }

        navigate "return-to-documentation-home-after-document-comparison" {
            url = "http://127.0.0.1:4175/docs/"
        }

        navigate "open-document-index-documentation" {
            url = "http://127.0.0.1:4175/docs/components/document.html"
        }

        wait "document-index-documentation-is-open" {
            text = "每个已标记索引项保存为可选择的行内原子节点"
        }

        expect "document-index-is-documented" {
            visible = css("main h2[id='原生文档索引']")
        }

        navigate "return-to-documentation-home-after-document-index" {
            url = "http://127.0.0.1:4175/docs/"
        }

        navigate "open-table-of-contents-documentation" {
            url = "http://127.0.0.1:4175/docs/components/document.html"
        }

        wait "table-of-contents-documentation-is-open" {
            text = "Writer 把目录保存为可选择、不可直接改写的类型化块"
        }

        expect "table-of-contents-is-documented" {
            visible = css("main h2[id='原生可更新目录']")
        }

        navigate "return-to-documentation-home" {
            url = "http://127.0.0.1:4175/docs/"
        }

        navigate "open-data-validation-documentation" {
            url = "http://127.0.0.1:4175/docs/components/spreadsheet.html"
        }

        wait "data-validation-documentation-is-open" {
            text = "同一弹窗维护完整的常用验证元数据"
        }

        expect "data-validation-settings-are-documented" {
            visible = css("main h3[id='输入信息与错误警告设置']")
        }

        navigate "return-to-documentation-home-after-data-validation" {
            url = "http://127.0.0.1:4175/docs/"
        }

        navigate "open-structured-reference-documentation" {
            url = "http://127.0.0.1:4175/docs/components/spreadsheet.html"
        }

        wait "structured-reference-documentation-is-open" {
            text = "浏览器计算内核现在可以解析常见且有界的原生表格公式"
        }

        expect "structured-reference-calculation-is-documented" {
            visible = css("main h2[id='结构化引用计算']")
        }

        navigate "open-pdf-page-organization-documentation" {
            url = "http://127.0.0.1:4175/docs/components/pdf.html"
        }

        wait "pdf-page-organization-documentation-is-open" {
            text = "同一个页面组织器支持"
        }

        expect "pdf-page-organization-is-documented" {
            visible = css("main h2[id='页面组织']")
        }

        console "latest-documentation-console" {
            path = "diagnostics/latest-documentation-console.json"
            clear = false
        }

        page_errors "latest-documentation-errors" {
            path = "diagnostics/latest-documentation-errors.json"
            clear = false
        }
    }

    scenario "find-feature-templates-on-phone" {
        name = "Find feature examples in the template grid on a phone"
        surface = "web"
        timeout_ms = 90000

        viewport "phone" {
            width = 390
            height = 844
            scale = 1
        }

        navigate "open-phone-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "phone-template-grid-is-visible" {
            visible = css(".playground-template-section")
        }

        expect "phone-entrance-exit-animation-entry-is-visible" {
            visible = css("button[data-template-id='animated-deck']")
        }

        expect "phone-document-comparison-entry-is-visible" {
            visible = css("button[data-template-id='document-comparison']")
        }

        expect "phone-table-of-contents-entry-is-visible" {
            visible = css("button[data-template-id='table-of-contents']")
        }

        expect "phone-document-index-entry-is-visible" {
            visible = css("button[data-template-id='document-index']")
        }

        expect "phone-data-validation-entry-is-visible" {
            visible = css("button[data-template-id='data-validation']")
        }

        expect "phone-conditional-format-entry-is-visible" {
            visible = css("button[data-template-id='conditional-format']")
        }

        expect "phone-structured-reference-entry-is-visible" {
            visible = css("button[data-template-id='structured-references']")
        }

        screenshot "phone-template-layout" {
            path = "screenshots/phone-playground-templates.png"
        }

        accessibility "phone-template-accessibility" {
            path = "evidence/phone-playground-templates.json"
            interactive = true
        }

        console "phone-template-console" {
            path = "diagnostics/phone-playground-template-console.json"
            clear = false
        }

        page_errors "phone-template-errors" {
            path = "diagnostics/phone-playground-template-errors.json"
            clear = false
        }
    }
}
