suite "office-presentation-chinese-ime" {
    version = 1

    scenario "commit-chinese-title-once" {
        name = "Commit Chinese Presentation text without phonetic pre-edit text"
        surface = "web"
        timeout_ms = 30000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-blank-presentation" {
            target = text("演示", true)
        }

        wait "blank-title-focused-and-editable" {
            visible = css("[data-presentation-text-engine='tiptap'][contenteditable='true']:focus")
        }

        type "enter-chinese-presentation-title" {
            target = css("[data-presentation-text-engine='tiptap'][contenteditable='true']")
            value = "中文输入只提交一次"
        }

        expect "chinese-title-committed-exactly-once" {
            target = css("[data-presentation-text-engine='tiptap'][contenteditable='true']")
            rendered_text = "中文输入只提交一次"
        }

        screenshot "committed-chinese-title" {
            path = "screenshots/presentation-chinese-ime.png"
        }

        click "return-to-playground-home" {
            target = css(".work-editor-back")
        }

        click "reopen-presentation" {
            target = text("无标题演示", true)
        }

        expect "chinese-title-persists" {
            text = "中文输入只提交一次"
        }

        accessibility "presentation-accessibility" {
            path = "evidence/presentation-chinese-ime.json"
            interactive = true
        }

        console "browser-console" {
            path = "diagnostics/presentation-chinese-ime-console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/presentation-chinese-ime-errors.json"
            clear = false
        }
    }
}
