suite "office-presentation-new-slide" {
    version = 1

    scenario "create-slide-with-wps-ctrl-m" {
        name = "Create a slide with WPS Ctrl+M"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-presentation-home" {
            target = css(".playground-home")
        }

        press "scroll-presentation-into-view" {
            key = "PageDown"
        }

        click "open-presentation" {
            target = css("button[data-template-id='strategy-deck']")
        }

        wait "presentation-ready" {
            visible = css(".work-presentation-editor")
        }

        expect "initial-slide-count" {
            visible = css(".work-slide-strip [data-slide-thumbnail][data-slide-index='2']")
        }

        expect "new-slide-shortcut" {
            visible = css("button[aria-label='新建幻灯片'][aria-keyshortcuts='Control+M Meta+Shift+N']")
        }

        click "focus-active-thumbnail" {
            target = css(".work-slide-strip [data-slide-thumbnail].active")
        }

        press "create-slide" {
            key = "Control+m"
        }

        wait "fourth-slide" {
            visible = css(".work-slide-strip [data-slide-thumbnail][data-slide-index='3'].active")
        }

        expect "new-slide-selected" {
            visible = css(".work-slide-strip [data-slide-thumbnail][data-slide-index='3'].active")
        }

        accessibility "presentation-new-slide-accessibility" {
            path = "evidence/presentation-new-slide-accessibility.json"
        }

        console "presentation-new-slide-console" {
            path = "diagnostics/presentation-new-slide-console.json"
        }

        page_errors "presentation-new-slide-page-errors" {
            path = "diagnostics/presentation-new-slide-page-errors.json"
        }
    }
}
