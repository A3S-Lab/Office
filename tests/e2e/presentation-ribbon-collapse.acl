suite "office-presentation-ribbon-collapse" {
    version = 1

    scenario "toggle-wps-presentation-ribbon-with-ctrl-f1" {
        name = "Collapse and expand Presentation ribbon with WPS Ctrl+F1"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-presentation-home" {
            target = css(".playground-home")
        }

        press "scroll-presentation-into-view" {
            key = "PageDown"
        }

        click "open-presentation" {
            target = css("button[data-template-id='strategy-deck']")
        }

        wait "presentation-ready" {
            visible = css(".work-presentation-editor .work-presentation-ribbon")
        }

        expect "collapse-control-visible" {
            visible = css(".work-presentation-ribbon .work-office-ribbon-collapse[aria-label='折叠功能区'][aria-keyshortcuts='Control+F1 Meta+F1']")
        }

        press "collapse-ribbon" {
            key = "Control+F1"
        }

        expect "ribbon-collapsed" {
            visible = css(".work-presentation-ribbon[data-collapsed='true'] .work-office-ribbon-collapse[aria-label='展开功能区'][aria-expanded='false']")
        }

        press "expand-ribbon" {
            key = "Control+F1"
        }

        expect "ribbon-expanded" {
            visible = css(".work-presentation-ribbon:not([data-collapsed]) .work-office-ribbon-collapse[aria-label='折叠功能区'][aria-expanded='true']")
        }
    }
}
