suite "office-presentation-slideshow-blank" {
    version = 1

    scenario "toggle-wps-slideshow-blank-screens" {
        name = "Toggle WPS slideshow black and white blank screens with B and W"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-presentation-home" {
            target = css(".playground-home")
        }

        press "scroll-presentation-into-view" {
            key = "PageDown"
        }

        click "open-presentation" {
            target = css("button[data-template-id='strategy-deck']")
        }

        wait "presentation-ready" {
            visible = css(".work-presentation-editor")
        }

        click "open-slideshow-tab" {
            target = role("tab", "幻灯片放映")
        }

        click "start-slideshow" {
            target = role("button", "从头开始放映")
        }

        wait "slideshow-open" {
            visible = css("[role='dialog'][aria-label='幻灯片放映'] .work-presentation-player[data-blank-screen='off']")
        }

        press "black-screen" {
            key = "b"
        }

        expect "black-screen-active" {
            visible = css(".work-presentation-player[data-blank-screen='black'] [aria-label='黑屏']")
        }

        press "clear-black-screen" {
            key = "b"
        }

        expect "blank-screen-cleared" {
            visible = css(".work-presentation-player[data-blank-screen='off']")
        }

        press "white-screen" {
            key = "w"
        }

        expect "white-screen-active" {
            visible = css(".work-presentation-player[data-blank-screen='white'] [aria-label='白屏']")
        }

        press "switch-to-black" {
            key = "b"
        }

        expect "black-screen-from-white" {
            visible = css(".work-presentation-player[data-blank-screen='black'] [aria-label='黑屏']")
        }

        press "exit-slideshow" {
            key = "Escape"
        }

        expect "slideshow-closed" {
            visible = css(".work-presentation-editor")
        }

        accessibility "slideshow-blank-accessibility" {
            path = "evidence/slideshow-blank-accessibility.json"
            interactive = true
        }

        console "slideshow-blank-console" {
            path = "diagnostics/slideshow-blank-console.json"
            clear = false
        }

        page_errors "slideshow-blank-page-errors" {
            path = "diagnostics/slideshow-blank-page-errors.json"
            clear = false
        }
    }
}
