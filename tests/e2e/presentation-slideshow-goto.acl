suite "office-presentation-slideshow-goto" {
    version = 1

    scenario "jump-to-slide-with-wps-digit-enter" {
        name = "Jump to a slide with WPS digit+Enter navigation"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-presentation-home" {
            target = css(".playground-home")
        }

        press "scroll-presentation-into-view" {
            key = "PageDown"
        }

        click "open-presentation" {
            target = css("button[data-template-id='strategy-deck']")
        }

        wait "presentation-ready" {
            visible = css(".work-presentation-editor")
        }

        click "open-slideshow-tab" {
            target = role("tab", "幻灯片放映")
        }

        click "start-slideshow" {
            target = role("button", "从头开始放映")
        }

        wait "slideshow-open" {
            visible = css("[role='dialog'][aria-label='幻灯片放映'] .work-presentation-player[data-slide-index='0'][data-blank-screen='off']")
        }

        press "type-slide-two" {
            key = "2"
        }

        expect "goto-buffer-visible" {
            visible = css(".work-presentation-player[data-goto-digits='2']")
        }

        press "confirm-goto" {
            key = "Enter"
        }

        expect "jumped-to-slide-two" {
            visible = css(".work-presentation-player[data-slide-index='1']:not([data-goto-digits])")
        }

        press "type-overflow-slide" {
            key = "9"
        }

        expect "overflow-buffer-visible" {
            visible = css(".work-presentation-player[data-goto-digits='9']")
        }

        press "confirm-overflow-goto" {
            key = "Enter"
        }

        expect "clamped-to-last-slide" {
            visible = css(".work-presentation-player[data-slide-index='2']:not([data-goto-digits])")
        }

        press "exit-slideshow" {
            key = "Escape"
        }

        expect "slideshow-closed" {
            visible = css(".work-presentation-editor")
        }

        accessibility "slideshow-goto-accessibility" {
            path = "evidence/slideshow-goto-accessibility.json"
            interactive = true
        }

        console "slideshow-goto-console" {
            path = "diagnostics/slideshow-goto-console.json"
            clear = false
        }

        page_errors "slideshow-goto-page-errors" {
            path = "diagnostics/slideshow-goto-page-errors.json"
            clear = false
        }
    }
}
