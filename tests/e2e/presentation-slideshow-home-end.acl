suite "office-presentation-slideshow-home-end" {
    version = 1

    scenario "jump-slideshow-with-wps-home-end" {
        name = "Jump to first and last slides with WPS Home / End in slideshow"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        focus "focus-presentation-home" {
            target = css(".playground-home")
        }

        press "scroll-presentation-into-view" {
            key = "PageDown"
        }

        click "open-presentation" {
            target = css("button[data-template-id='strategy-deck']")
        }

        wait "presentation-ready" {
            visible = css(".work-presentation-editor")
        }

        click "open-slideshow-tab" {
            target = role("tab", "幻灯片放映")
        }

        click "start-slideshow" {
            target = role("button", "从头开始放映")
        }

        wait "slideshow-open" {
            visible = css("[role='dialog'][aria-label='幻灯片放映'] .work-presentation-player[data-slide-index='0'][data-blank-screen='off']")
        }

        expect "previous-shortcut-includes-home" {
            visible = css(".work-presentation-player button[aria-label='上一张'][aria-keyshortcuts='ArrowLeft ArrowUp PageUp Home']")
        }

        expect "next-shortcut-includes-end" {
            visible = css(".work-presentation-player button[aria-label='下一张'][aria-keyshortcuts='ArrowRight ArrowDown PageDown Space End']")
        }

        press "jump-to-last" {
            key = "End"
        }

        wait "last-slide" {
            visible = css(".work-presentation-player[data-slide-index='2']")
        }

        press "jump-to-first" {
            key = "Home"
        }

        wait "first-slide" {
            visible = css(".work-presentation-player[data-slide-index='0']")
        }

        accessibility "presentation-slideshow-home-end-accessibility" {
            path = "evidence/presentation-slideshow-home-end-accessibility.json"
            interactive = true
        }

        console "presentation-slideshow-home-end-console" {
            path = "diagnostics/presentation-slideshow-home-end-console.json"
            clear = false
        }

        page_errors "presentation-slideshow-home-end-page-errors" {
            path = "diagnostics/presentation-slideshow-home-end-page-errors.json"
            clear = false
        }
    }
}
