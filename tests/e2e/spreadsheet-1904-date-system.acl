suite "spreadsheet-1904-date-system" {
    version = 1

    scenario "import-filter-and-reopen-1904-workbook" {
        name = "Retain 1904 dates while importing, filtering, and reopening a workbook"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/?e2e=spreadsheet-1904-date-system"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        upload "open-1904-workbook" {
            target = css("input[aria-label='打开 Office 或 PDF 文件']")
            paths = [".a3s-test/fixtures/spreadsheet-1904-date-system.xlsx"]
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "imported-1904-filter-state" {
            visible = css("[data-testid='spreadsheet-1904-date-system-status'][data-date-system='1904'][data-january-serial='0'][data-february-hidden='true']")
        }

        expect "imported-dynamic-filter-is-active" {
            visible = css(".luckysheet-filter-options.luckysheet-filter-options-active")
        }

        focus "focus-imported-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "select-imported-header" {
            key = "Control+Home"
        }

        expect "imported-header-selected" {
            text = "A1"
        }

        press "select-visible-january-date" {
            key = "ArrowDown"
        }

        expect "january-serial-remains-visible" {
            text = "A2"
        }

        click "return-to-office-home" {
            target = role("button", "返回办公首页")
        }

        wait "imported-workbook-card-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "reopen-imported-workbook" {
            target = text("spreadsheet-1904-date-system", true)
        }

        wait "reopened-spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "reopened-1904-filter-state" {
            visible = css("[data-testid='spreadsheet-1904-date-system-status'][data-date-system='1904'][data-january-serial='0'][data-february-hidden='true']")
        }

        expect "reopened-dynamic-filter-is-active" {
            visible = css(".luckysheet-filter-options.luckysheet-filter-options-active")
        }

        focus "focus-reopened-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "select-reopened-header" {
            key = "Control+Home"
        }

        press "select-reopened-january-date" {
            key = "ArrowDown"
        }

        expect "reopened-january-serial-remains-visible" {
            text = "A2"
        }

        accessibility "spreadsheet-1904-date-system-accessibility" {
            path = "evidence/spreadsheet-1904-date-system.json"
            interactive = true
        }

        console "spreadsheet-1904-date-system-console" {
            path = "diagnostics/spreadsheet-1904-date-system-console.json"
            clear = false
        }

        page_errors "spreadsheet-1904-date-system-page-errors" {
            path = "diagnostics/spreadsheet-1904-date-system-page-errors.json"
            clear = false
        }
    }
}
