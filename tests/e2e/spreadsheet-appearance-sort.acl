suite "office-spreadsheet-appearance-sort" {
    version = 1

    scenario "sort-effective-colors-icons-and-undo" {
        name = "Sort effective cell color, font color, and conditional icon, then undo"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-appearance-sort-fixture" {
            url = "http://127.0.0.1:4175/playground/?e2e=spreadsheet-appearance-sort"
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "appearance-range-selected" {
            text = "A1:D6"
        }

        click "open-data-tab" {
            target = role("tab", "数据")
        }

        click "open-custom-sort" {
            target = role("button", "自定义排序")
        }

        expect "custom-sort-dialog-visible" {
            visible = css(".work-spreadsheet-sort-dialog[role='dialog']")
        }

        expect "header-is-retained" {
            visible = css(".work-spreadsheet-sort-dialog .work-office-checkbox.checked:has(input[aria-label='数据包含标题']:checked)")
        }

        expect "status-column-is-primary" {
            visible = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 1 列']:has(option[value='1']:checked)")
        }

        select "sort-primary-by-cell-color" {
            target = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 1 排序依据']")
            values = ["cell-color"]
        }

        select "put-red-fill-first" {
            target = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 1 目标外观']")
            values = ["cell-color:#fce8e6"]
        }

        expect "red-fill-preview" {
            text = "单元格颜色 #FCE8E6，置于顶端"
        }

        click "add-yellow-fill-level" {
            target = role("button", "添加条件")
        }

        select "reuse-status-column" {
            target = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 2 列']")
            values = ["1"]
        }

        select "sort-secondary-by-cell-color" {
            target = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 2 排序依据']")
            values = ["cell-color"]
        }

        select "put-yellow-fill-second" {
            target = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 2 目标外观']")
            values = ["cell-color:#fff2cc"]
        }

        expect "yellow-fill-preview" {
            text = "单元格颜色 #FFF2CC，置于顶端"
        }

        click "add-font-color-level" {
            target = role("button", "添加条件")
        }

        expect "task-column-is-tertiary" {
            visible = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 3 列']:has(option[value='0']:checked)")
        }

        select "sort-tertiary-by-font-color" {
            target = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 3 排序依据']")
            values = ["font-color"]
        }

        select "put-red-font-third" {
            target = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 3 目标外观']")
            values = ["font-color:#d84b4f"]
        }

        expect "red-font-preview" {
            text = "字体颜色 #D84B4F，置于顶端"
        }

        click "add-icon-level" {
            target = role("button", "添加条件")
        }

        expect "score-column-is-fourth" {
            visible = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 4 列']:has(option[value='2']:checked)")
        }

        select "sort-fourth-by-icon" {
            target = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 4 排序依据']")
            values = ["icon"]
        }

        select "put-high-icon-first" {
            target = css(".work-spreadsheet-sort-dialog select[aria-label='排序条件 4 目标外观']")
            values = ["icon:3TrafficLights1:2"]
        }

        expect "high-icon-preview" {
            text = "三色交通灯（实心） 3/3，置于顶端"
        }

        accessibility "appearance-sort-dialog-accessibility" {
            path = "evidence/spreadsheet-appearance-sort-dialog.json"
            interactive = true
        }

        click "apply-appearance-sort" {
            target = role("button", "确定")
        }

        expect "sort-focus-restored" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='自定义排序']:focus")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "go-to-sheet-start" {
            key = "Control+Home"
        }

        press "inspect-first-data-row" {
            key = "ArrowDown"
        }

        expect "red-fill-and-font-row-is-first" {
            text = "Zulu"
        }

        press "inspect-second-red-row" {
            key = "ArrowDown"
        }

        expect "second-red-row-precedes-yellow" {
            text = "Beta"
        }

        press "inspect-yellow-row" {
            key = "ArrowDown"
        }

        expect "yellow-row-precedes-other-colors" {
            text = "Gamma"
        }

        press "return-to-first-sorted-row" {
            key = "Control+Home"
        }

        press "inspect-first-data-row-again" {
            key = "ArrowDown"
        }

        press "jump-to-formula" {
            key = "Control+ArrowRight"
        }

        expect "moved-formula-is-rebased" {
            text = "=C2+90"
        }

        press "undo-appearance-sort" {
            key = "Control+z"
        }

        expect "original-formula-is-restored" {
            text = "=C2*2"
        }

        expect "grid-focus-restored-after-undo" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        press "inspect-restored-score" {
            key = "ArrowLeft"
        }

        press "inspect-restored-status" {
            key = "ArrowLeft"
        }

        press "inspect-restored-task" {
            key = "ArrowLeft"
        }

        expect "original-row-order-is-restored" {
            text = "Alpha"
        }

        accessibility "spreadsheet-after-appearance-sort-accessibility" {
            path = "evidence/spreadsheet-after-appearance-sort.json"
            interactive = true
        }

        console "appearance-sort-console" {
            path = "diagnostics/spreadsheet-appearance-sort-console.json"
            clear = false
        }

        page_errors "appearance-sort-page-errors" {
            path = "diagnostics/spreadsheet-appearance-sort-page-errors.json"
            clear = false
        }
    }
}
