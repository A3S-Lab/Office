suite "office-spreadsheet-cell-style" {
    version = 1

    scenario "apply-wps-cell-style" {
        name = "Apply and undo a WPS cell style from the grouped gallery"
        surface = "web"
        timeout_ms = 120000

        viewport "compact" {
            width = 768
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/?e2e=spreadsheet-cell-style"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "create-worksheet" {
            key = "Shift+F11"
        }

        fill "enter-value" {
            target = label("当前单元格输入")
            value = "Ready"
        }

        press "commit-value" {
            key = "Enter"
        }

        press "return-to-value" {
            key = "ArrowUp"
        }

        press "extend-right" {
            key = "Shift+ArrowRight"
        }

        press "extend-down" {
            key = "Shift+ArrowDown"
        }

        expect "cell-style-command-visible" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='单元格样式'][aria-haspopup='menu']")
        }

        click "open-cell-style-gallery" {
            target = role("button", "单元格样式")
        }

        expect "grouped-gallery-visible" {
            visible = css("[role='menu'][aria-label='单元格样式库'] fieldset[aria-label='数据和模型']")
        }

        expect "normal-style-focused" {
            visible = css("[role='menu'][aria-label='单元格样式库'] [role='menuitemradio'][aria-label='应用单元格样式：常规']:focus")
        }

        press "focus-next-style" {
            key = "ArrowRight"
        }

        expect "good-style-focused" {
            visible = css("[role='menu'][aria-label='单元格样式库'] [role='menuitemradio'][aria-label='应用单元格样式：好']:focus")
        }

        press "focus-next-style-row" {
            key = "ArrowDown"
        }

        expect "neutral-style-focused" {
            visible = css("[role='menu'][aria-label='单元格样式库'] [role='menuitemradio'][aria-label='应用单元格样式：适中']:focus")
        }

        press "focus-last-style" {
            key = "End"
        }

        expect "total-style-focused" {
            visible = css("[role='menu'][aria-label='单元格样式库'] [role='menuitemradio'][aria-label='应用单元格样式：总计']:focus")
        }

        press "focus-first-style" {
            key = "Home"
        }

        click "apply-good-style" {
            target = role("menuitemradio", "应用单元格样式：好")
        }

        expect "style-gallery-closed-and-trigger-focused" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='单元格样式'][title='单元格样式（当前：好）']:focus")
        }

        focus "return-to-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "select-first-cell" {
            key = "Control+Home"
        }

        press "select-styled-blank-column" {
            key = "ArrowRight"
        }

        press "select-styled-blank-row" {
            key = "ArrowDown"
        }

        expect "style-persists-on-blank-cell" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='单元格样式'][title='单元格样式（当前：好）']")
        }

        screenshot "spreadsheet-cell-style-applied" {
            path = "screenshots/spreadsheet-cell-style-applied.png"
        }

        click "undo-cell-style" {
            target = role("button", "撤销")
        }

        expect "cell-style-undone-in-one-step" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='单元格样式'][title='单元格样式（当前：常规）']")
        }

        click "reopen-cell-style-gallery" {
            target = role("button", "单元格样式")
        }

        press "focus-total-style-again" {
            key = "End"
        }

        expect "total-style-focused-again" {
            visible = css("[role='menu'][aria-label='单元格样式库'] [role='menuitemradio'][aria-label='应用单元格样式：总计']:focus")
        }

        press "apply-total-style" {
            key = "Enter"
        }

        expect "border-style-is-current" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='单元格样式'][title='单元格样式（当前：总计）']")
        }

        click "undo-border-style" {
            target = role("button", "撤销")
        }

        expect "border-style-undone-in-one-step" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='单元格样式'][title='单元格样式（当前：常规）']")
        }

        accessibility "cell-style-accessibility" {
            path = "evidence/cell-style-accessibility.json"
            interactive = true
        }

        console "cell-style-console" {
            path = "diagnostics/cell-style-console.json"
            clear = false
        }

        page_errors "cell-style-page-errors" {
            path = "diagnostics/cell-style-page-errors.json"
            clear = false
        }
    }
}
