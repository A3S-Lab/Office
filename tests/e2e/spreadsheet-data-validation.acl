suite "spreadsheet-data-validation" {
    version = 1

    scenario "open-public-data-validation-template" {
        name = "Open the public Spreadsheet data-validation template"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground-home" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "playground-home-ready" {
            text = "我的文档"
        }

        click "open-public-data-validation-template" {
            target = css("button[data-template-id='data-validation']")
        }

        wait "public-template-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "public-template-title-visible" {
            visible = css("input[aria-label='文件名'][value='数据验证示例']")
        }

        click "open-public-template-data-tab" {
            target = role("tab", "数据")
        }

        click "open-public-template-validation-dialog" {
            target = role("button", "数据验证")
        }

        expect "public-template-range-visible" {
            text = "Inputs!B2:B6"
        }

        expect "public-template-list-source-visible" {
            visible = css(".work-spreadsheet-data-validation-dialog input[aria-label='来源'][value=\"'Lists'!A1:A3\"]")
        }

        expect "public-template-input-settings-visible" {
            visible = css(".work-spreadsheet-data-validation-dialog:has(input[aria-label='忽略空值']:not(:checked)):has(input[aria-label='在单元格内显示下拉箭头']:checked):has(input[aria-label='选中单元格时显示输入信息']:checked)")
        }

        expect "public-template-input-title-visible" {
            visible = css(".work-spreadsheet-data-validation-dialog input[aria-label='输入信息标题'][value='Workflow state']")
        }

        expect "public-template-error-settings-visible" {
            visible = css(".work-spreadsheet-data-validation-dialog:has(select[aria-label='错误警告样式'] option[value='stop']:checked):has(input[aria-label='错误警告标题'][value='Invalid state'])")
        }

        press "close-public-template-dialog" {
            key = "Escape"
        }

        focus "focus-public-template-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "select-public-template-home" {
            key = "Control+Home"
        }

        press "select-public-template-owner-row" {
            key = "ArrowDown"
        }

        press "select-public-template-owner-column-1" {
            key = "ArrowRight"
        }

        press "select-public-template-owner-column-2" {
            key = "ArrowRight"
        }

        press "select-public-template-owner-column-3" {
            key = "ArrowRight"
        }

        press "select-public-template-owner-column-4" {
            key = "ArrowRight"
        }

        expect "public-template-owner-selected" {
            text = "E2"
        }

        click "open-public-template-custom-validation" {
            target = role("button", "数据验证")
        }

        expect "public-template-custom-range-visible" {
            text = "Inputs!E2"
        }

        expect "public-template-custom-type-visible" {
            visible = css(".work-spreadsheet-data-validation-dialog select:has(option[value='custom']:checked)")
        }

        expect "public-template-custom-formula-visible" {
            visible = css(".work-spreadsheet-data-validation-dialog textarea[aria-label='公式']")
        }

        expect "public-template-custom-formula-value-visible" {
            visible = css(".work-spreadsheet-data-validation-dialog textarea[aria-label='公式']")
        }

        press "close-public-template-custom-dialog" {
            key = "Escape"
        }

        accessibility "public-template-accessibility" {
            path = "evidence/public-template-accessibility.json"
            interactive = true
        }

        console "public-template-console" {
            path = "diagnostics/public-template-console.json"
            clear = false
        }

        page_errors "public-template-page-errors" {
            path = "diagnostics/public-template-page-errors.json"
            clear = false
        }
    }

    scenario "apply-remove-and-undo-data-validation" {
        name = "Apply, remove, and undo Traditional Office spreadsheet data validation"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-data-validation-fixture" {
            url = "http://127.0.0.1:4175/playground/?e2e=spreadsheet-data-validation"
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        click "open-data-tab" {
            target = role("tab", "数据")
        }

        click "open-data-validation" {
            target = role("button", "数据验证")
        }

        expect "multi-range-dialog-visible" {
            text = "Inputs!B2:B3,D5:E5"
        }

        expect "multi-range-count-visible" {
            text = "2 个选定区域"
        }

        press "cancel-first-dialog" {
            key = "Escape"
        }

        expect "ribbon-trigger-restored" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='数据验证']:focus")
        }

        click "reopen-data-validation" {
            target = role("button", "数据验证")
        }

        fill "enter-invalid-list-range" {
            target = css(".work-spreadsheet-data-validation-dialog input[aria-label='来源']")
            value = "'Lists'!A1:B2"
        }

        expect "two-dimensional-source-rejected" {
            text = "下拉列表来源只能是一行或一列连续单元格。"
        }

        fill "enter-valid-list-range" {
            target = css(".work-spreadsheet-data-validation-dialog input[aria-label='来源']")
            value = "'Lists'!A1:A3"
        }

        click "enable-input-message" {
            target = css(".work-spreadsheet-data-validation-dialog .work-office-checkbox:has(input[aria-label='选中单元格时显示输入信息'])")
        }

        fill "enter-input-title" {
            target = css(".work-spreadsheet-data-validation-dialog input[aria-label='输入信息标题']")
            value = "Workflow state"
        }

        fill "enter-input-message" {
            target = css(".work-spreadsheet-data-validation-dialog textarea[aria-label='输入信息']")
            value = "Choose a workflow state."
        }

        click "require-nonblank-input" {
            target = css(".work-spreadsheet-data-validation-dialog .work-office-checkbox:has(input[aria-label='忽略空值'])")
        }

        click "hide-dropdown-arrow" {
            target = css(".work-spreadsheet-data-validation-dialog .work-office-checkbox:has(input[aria-label='在单元格内显示下拉箭头'])")
        }

        select "choose-warning-style" {
            target = css(".work-spreadsheet-data-validation-dialog select[aria-label='错误警告样式']")
            values = ["warning"]
        }

        fill "enter-error-title" {
            target = css(".work-spreadsheet-data-validation-dialog input[aria-label='错误警告标题']")
            value = "Invalid state"
        }

        fill "enter-error-message" {
            target = css(".work-spreadsheet-data-validation-dialog textarea[aria-label='错误警告消息']")
            value = "Choose Ready, Blocked, or In review."
        }

        click "apply-data-validation" {
            target = role("button", "确定")
        }

        expect "trigger-restored-after-apply" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='数据验证']:focus")
        }

        click "reopen-applied-validation" {
            target = role("button", "数据验证")
        }

        expect "normalized-list-source-visible" {
            visible = css(".work-spreadsheet-data-validation-dialog input[value=\"'Lists'!A1:A3\"]")
        }

        expect "input-settings-reopen" {
            visible = css(".work-spreadsheet-data-validation-dialog:has(input[aria-label='选中单元格时显示输入信息']:checked)")
        }

        expect "input-title-reopens" {
            visible = css(".work-spreadsheet-data-validation-dialog input[aria-label='输入信息标题'][value='Workflow state']")
        }

        expect "error-style-reopens" {
            visible = css(".work-spreadsheet-data-validation-dialog:has(select[aria-label='错误警告样式'] option[value='warning']:checked)")
        }

        expect "error-title-reopens" {
            visible = css(".work-spreadsheet-data-validation-dialog input[aria-label='错误警告标题'][value='Invalid state']")
        }

        expect "blank-and-arrow-settings-reopen" {
            visible = css(".work-spreadsheet-data-validation-dialog:has(input[aria-label='忽略空值']:not(:checked)):has(input[aria-label='在单元格内显示下拉箭头']:not(:checked))")
        }

        expect "remove-action-visible" {
            visible = css(".work-spreadsheet-data-validation-remove")
        }

        click "remove-data-validation" {
            target = role("button", "全部清除")
        }

        click "verify-validation-was-removed" {
            target = role("button", "数据验证")
        }

        expect "remove-action-absent" {
            visible = css(".work-spreadsheet-data-validation-dialog:not(:has(.work-spreadsheet-data-validation-remove))")
        }

        press "close-empty-dialog" {
            key = "Escape"
        }

        click "undo-remove" {
            target = role("button", "撤销")
        }

        click "verify-remove-undo" {
            target = role("button", "数据验证")
        }

        expect "remove-restored-in-one-step" {
            visible = css(".work-spreadsheet-data-validation-remove")
        }

        press "close-restored-dialog" {
            key = "Escape"
        }

        click "undo-apply" {
            target = role("button", "撤销")
        }

        click "verify-apply-undo" {
            target = role("button", "数据验证")
        }

        expect "validation-absent-after-undo" {
            visible = css(".work-spreadsheet-data-validation-dialog:not(:has(.work-spreadsheet-data-validation-remove))")
        }

        press "close-final-dialog" {
            key = "Escape"
        }

        expect "validation-history-empty" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='撤销']:disabled")
        }

        accessibility "spreadsheet-data-validation-accessibility" {
            path = "evidence/accessibility.json"
            interactive = true
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }

    scenario "follow-error-alert-branches" {
        name = "Follow Traditional Office data-validation error-alert branches"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-data-validation-template" {
            url = "http://127.0.0.1:4175/playground/"
        }

        click "open-template" {
            target = css("button[data-template-id='data-validation']")
        }

        wait "grid-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "select-first-cell" {
            key = "Control+Home"
        }

        press "select-state-cell" {
            key = "ArrowDown"
        }

        press "select-state-column" {
            key = "ArrowRight"
        }

        focus "focus-formula-bar" {
            target = css(".fortune-fx-input")
        }

        press "select-formula-bar-value" {
            key = "Control+a"
        }

        type "enter-invalid-state" {
            target = css(".fortune-fx-input")
            value = "Not a state"
        }

        press "commit-invalid-state" {
            key = "Enter"
        }

        expect "stop-branch-visible" {
            visible = css(".work-office-dialog[role='dialog']")
        }

        expect "stop-branch-message" {
            text = "Choose a state from the list."
        }

        click "dismiss-stop-branch" {
            target = role("button", "知道了")
        }

        expect "stop-branch-restores-value" {
            visible = css(".fortune-fx-input")
        }

        expect "stop-branch-restored-text" {
            text = "Ready"
        }

        press "select-date-cell" {
            key = "ArrowRight"
        }

        focus "refocus-date-formula-bar" {
            target = css(".fortune-fx-input")
        }

        press "select-date-value" {
            key = "Control+a"
        }

        type "enter-invalid-date" {
            target = css(".fortune-fx-input")
            value = "2027-01-01"
        }

        press "commit-invalid-date" {
            key = "Enter"
        }

        expect "information-branch-visible" {
            visible = css(".work-office-dialog[role='dialog']")
        }

        expect "information-branch-message" {
            text = "Enter a date in calendar year 2026."
        }

        click "keep-information-value" {
            target = role("button", "保留输入")
        }

        expect "information-branch-keeps-value" {
            visible = css(".fortune-fx-input")
        }

        expect "information-branch-kept-text" {
            text = "2027-01-01"
        }

        press "select-priority-cell" {
            key = "ArrowRight"
        }

        focus "refocus-priority-formula-bar" {
            target = css(".fortune-fx-input")
        }

        press "select-priority-value" {
            key = "Control+a"
        }

        type "enter-invalid-priority" {
            target = css(".fortune-fx-input")
            value = "9"
        }

        press "commit-invalid-priority" {
            key = "Enter"
        }

        expect "warning-branch-visible" {
            visible = css(".work-office-dialog[role='dialog']")
        }

        expect "warning-branch-message" {
            text = "Enter a whole number from 1 through 5."
        }

        click "keep-warning-value" {
            target = role("button", "继续输入")
        }

        expect "warning-branch-keeps-value" {
            visible = css(".fortune-fx-input")
        }

        expect "warning-branch-kept-text" {
            text = "9"
        }

        press "select-owner-cell" {
            key = "ArrowRight"
        }

        focus "refocus-owner-formula-bar" {
            target = css(".fortune-fx-input")
        }

        press "select-owner-value" {
            key = "Control+a"
        }

        press "clear-owner-value" {
            key = "Backspace"
        }

        press "commit-invalid-owner" {
            key = "Enter"
        }

        expect "custom-formula-stop-branch-visible" {
            visible = css(".work-office-dialog[role='dialog']")
        }

        expect "custom-formula-stop-branch-title" {
            text = "Owner required"
        }

        expect "custom-formula-stop-branch-message" {
            text = "Enter an owner for every task."
        }

        click "dismiss-custom-formula-stop-branch" {
            target = role("button", "知道了")
        }

        expect "custom-formula-restores-owner" {
            visible = css(".fortune-fx-input")
        }

        accessibility "error-alert-branches-accessibility" {
            path = "evidence/error-alert-branches-accessibility.json"
            interactive = true
        }

        console "error-alert-branches-console" {
            path = "diagnostics/error-alert-branches-console.json"
            clear = false
        }

        page_errors "error-alert-branches-page-errors" {
            path = "diagnostics/error-alert-branches-page-errors.json"
            clear = false
        }
    }
}
