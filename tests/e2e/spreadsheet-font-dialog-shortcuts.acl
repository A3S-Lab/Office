suite "office-spreadsheet-font-dialog-shortcuts" {
    version = 1

    scenario "open-focused-font-controls" {
        name = "Open the focused Spreadsheet font controls from the grid"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-ribbon-alignment"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "open-font-family" {
            key = "Control+Shift+F"
        }

        expect "font-tab-selected" {
            visible = css(".work-spreadsheet-format-cells-dialog [role='tab'][data-tab-id='font'][aria-selected='true']")
        }

        expect "font-family-focused" {
            visible = css(".work-spreadsheet-format-cells-dialog [role='combobox'][aria-label='单元格字体'][aria-keyshortcuts='Control+Shift+F Meta+Shift+F']:focus")
        }

        screenshot "font-family-dialog" {
            path = "screenshots/font-family-dialog.png"
        }

        press "close-font-family" {
            key = "Escape"
        }

        expect "grid-restored-after-family" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        press "open-font-size" {
            key = "Control+Shift+P"
        }

        expect "font-size-focused" {
            visible = css(".work-spreadsheet-format-cells-dialog [role='combobox'][aria-label='单元格字号'][aria-keyshortcuts='Control+Shift+P Meta+Shift+P']:focus")
        }

        press "close-font-size" {
            key = "Escape"
        }

        expect "grid-restored-after-size" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        accessibility "font-dialog-accessibility" {
            path = "evidence/font-dialog-accessibility.json"
            interactive = true
        }

        console "font-dialog-console" {
            path = "diagnostics/font-dialog-console.json"
            clear = false
        }

        page_errors "font-dialog-page-errors" {
            path = "diagnostics/font-dialog-page-errors.json"
            clear = false
        }
    }
}
