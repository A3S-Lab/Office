suite "office-spreadsheet-gradient-fill" {
    version = 1

    scenario "render-gradient-gallery-at-desktop-width" {
        name = "Render native XLSX linear and path gradients at desktop width"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-gradient-gallery" {
            url = "http://127.0.0.1:4175/playground/?e2e=spreadsheet-gradient-fill"
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "all-gradients-are-declared" {
            visible = css("[data-testid='spreadsheet-gradient-fill-status'][data-authoring='format-cells'][data-gradient-count='6'][data-revision='1']")
        }

        expect "gradient-status-is-visible" {
            text = "原生 XLSX 渐变填充 · 6 个示例"
        }

        focus "focus-gradient-cell" {
            target = css(".fortune-sheet-overlay")
        }

        press "open-gradient-format-cells" {
            key = "Control+1"
        }

        click "open-gradient-fill-tab" {
            target = role("tab", "填充")
        }

        expect "imported-gradient-is-editable" {
            visible = css(".work-spreadsheet-format-cells-dialog input[type='radio'][value='gradient']:checked")
        }

        click "open-gradient-type" {
            target = role("combobox", "渐变类型")
        }

        click "choose-path-gradient" {
            target = role("option", "路径")
        }

        click "add-authored-gradient-stop" {
            target = role("button", "添加色标")
        }

        fill "set-authored-path-left" {
            target = css("input[aria-label='路径渐变左边界']")
            value = "20"
        }

        expect "path-gradient-draft-has-three-stops" {
            visible = css(".work-spreadsheet-format-cells-gradient-controls[data-gradient-type='path'] .work-spreadsheet-format-cells-gradient-stops[data-stop-count='3']")
        }

        click "apply-authored-path-gradient" {
            target = role("button", "应用")
        }

        focus "focus-grid-after-gradient-apply" {
            target = css(".fortune-sheet-overlay")
        }

        press "reopen-authored-gradient" {
            key = "Control+1"
        }

        click "reopen-authored-gradient-fill-tab" {
            target = role("tab", "填充")
        }

        expect "authored-path-gradient-persists" {
            visible = css(".work-spreadsheet-format-cells-gradient-controls[data-gradient-type='path'] .work-spreadsheet-format-cells-gradient-stops[data-stop-count='3']")
        }

        press "close-authored-gradient" {
            key = "Escape"
        }

        focus "focus-grid-before-gradient-undo" {
            target = css(".fortune-sheet-overlay")
        }

        press "undo-authored-gradient" {
            key = "Control+z"
        }

        press "inspect-gradient-undo" {
            key = "Control+1"
        }

        click "inspect-gradient-undo-fill-tab" {
            target = role("tab", "填充")
        }

        expect "undo-restores-imported-linear-gradient" {
            visible = css(".work-spreadsheet-format-cells-gradient-controls[data-gradient-type='linear'] .work-spreadsheet-format-cells-gradient-stops[data-stop-count='2']")
        }

        accessibility "desktop-gradient-accessibility" {
            path = "evidence/spreadsheet-gradient-fill-desktop.json"
            interactive = true
        }

        console "desktop-gradient-console" {
            path = "diagnostics/spreadsheet-gradient-fill-desktop-console.json"
            clear = false
        }

        page_errors "desktop-gradient-page-errors" {
            path = "diagnostics/spreadsheet-gradient-fill-desktop-page-errors.json"
            clear = false
        }
    }

    scenario "render-gradient-gallery-at-compact-width" {
        name = "Render native XLSX linear and path gradients at compact width"
        surface = "web"
        timeout_ms = 120000

        viewport "compact" {
            width = 768
            height = 800
            scale = 1
        }

        navigate "open-compact-gradient-gallery" {
            url = "http://127.0.0.1:4175/playground/?e2e=spreadsheet-gradient-fill"
        }

        wait "compact-spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-compact-gradient-cell" {
            target = css(".fortune-sheet-overlay")
        }

        press "open-compact-gradient-format-cells" {
            key = "Control+1"
        }

        click "open-compact-gradient-fill-tab" {
            target = role("tab", "填充")
        }

        expect "compact-imported-gradient-is-editable" {
            visible = css(".work-spreadsheet-format-cells-dialog input[type='radio'][value='gradient']:checked")
        }

        accessibility "compact-gradient-accessibility" {
            path = "evidence/spreadsheet-gradient-fill-compact.json"
            interactive = true
        }

        console "compact-gradient-console" {
            path = "diagnostics/spreadsheet-gradient-fill-compact-console.json"
            clear = false
        }

        page_errors "compact-gradient-page-errors" {
            path = "diagnostics/spreadsheet-gradient-fill-compact-page-errors.json"
            clear = false
        }
    }
}
