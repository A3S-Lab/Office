suite "office-spreadsheet-pattern-fill" {
    version = 1

    scenario "render-pattern-gallery-at-desktop-width" {
        name = "Render all native XLSX pattern fills at desktop width"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-pattern-gallery" {
            url = "http://127.0.0.1:4175/playground/?e2e=spreadsheet-pattern-fill"
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "all-patterns-are-declared" {
            visible = css("[data-testid='spreadsheet-pattern-fill-status'][data-authoring='format-cells'][data-pattern-count='17'][data-revision='1']")
        }

        expect "pattern-status-is-visible" {
            text = "原生 XLSX 图案填充 · 17 种样式"
        }

        focus "focus-pattern-cell" {
            target = css(".fortune-sheet-overlay")
        }

        press "open-pattern-format-cells" {
            key = "Control+1"
        }

        click "open-pattern-fill-tab" {
            target = role("tab", "填充")
        }

        expect "imported-pattern-is-editable" {
            visible = css(".work-spreadsheet-format-cells-dialog input[type='radio'][value='pattern']:checked")
        }

        click "open-pattern-type" {
            target = role("combobox", "填充图案样式")
        }

        click "choose-dark-trellis-pattern" {
            target = role("option", "深色菱形网格")
        }

        expect "authored-pattern-draft-is-visible" {
            text = "深色菱形网格"
        }

        click "apply-authored-pattern" {
            target = role("button", "应用")
        }

        focus "focus-grid-after-pattern-apply" {
            target = css(".fortune-sheet-overlay")
        }

        press "reopen-authored-pattern" {
            key = "Control+1"
        }

        click "reopen-authored-pattern-fill-tab" {
            target = role("tab", "填充")
        }

        expect "authored-pattern-persists" {
            text = "深色菱形网格"
        }

        press "close-authored-pattern" {
            key = "Escape"
        }

        focus "focus-grid-before-pattern-undo" {
            target = css(".fortune-sheet-overlay")
        }

        press "undo-authored-pattern" {
            key = "Control+z"
        }

        press "inspect-pattern-undo" {
            key = "Control+1"
        }

        click "inspect-pattern-undo-fill-tab" {
            target = role("tab", "填充")
        }

        expect "undo-restores-imported-pattern" {
            text = "深色下斜线"
        }

        accessibility "desktop-pattern-accessibility" {
            path = "evidence/spreadsheet-pattern-fill-desktop.json"
            interactive = true
        }

        console "desktop-pattern-console" {
            path = "diagnostics/spreadsheet-pattern-fill-desktop-console.json"
            clear = false
        }

        page_errors "desktop-pattern-page-errors" {
            path = "diagnostics/spreadsheet-pattern-fill-desktop-page-errors.json"
            clear = false
        }
    }

    scenario "render-pattern-gallery-at-compact-width" {
        name = "Render all native XLSX pattern fills at compact width"
        surface = "web"
        timeout_ms = 120000

        viewport "compact" {
            width = 768
            height = 800
            scale = 1
        }

        navigate "open-compact-pattern-gallery" {
            url = "http://127.0.0.1:4175/playground/?e2e=spreadsheet-pattern-fill"
        }

        wait "compact-spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-compact-pattern-cell" {
            target = css(".fortune-sheet-overlay")
        }

        press "open-compact-pattern-format-cells" {
            key = "Control+1"
        }

        click "open-compact-pattern-fill-tab" {
            target = role("tab", "填充")
        }

        expect "compact-imported-pattern-is-editable" {
            visible = css(".work-spreadsheet-format-cells-dialog input[type='radio'][value='pattern']:checked")
        }

        accessibility "compact-pattern-accessibility" {
            path = "evidence/spreadsheet-pattern-fill-compact.json"
            interactive = true
        }

        console "compact-pattern-console" {
            path = "diagnostics/spreadsheet-pattern-fill-compact-console.json"
            clear = false
        }

        page_errors "compact-pattern-page-errors" {
            path = "diagnostics/spreadsheet-pattern-fill-compact-page-errors.json"
            clear = false
        }
    }
}
