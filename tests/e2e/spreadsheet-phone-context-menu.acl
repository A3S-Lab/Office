suite "office-spreadsheet-phone-context-menu" {
    version = 1

    scenario "open-and-dismiss-phone-context-menu" {
        name = "Use the touch-sized Spreadsheet context menu on a phone"
        surface = "web"
        timeout_ms = 30000

        viewport "phone" {
            width = 390
            height = 700
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        wait "quarterly-plan-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-quarterly-plan" {
            target = css(".playground-artifact-card.spreadsheet")
        }

        wait "spreadsheet-grid-ready" {
            visible = css(".fortune-sheet-overlay")
        }

        context_click "open-selection-actions" {
            target = css(".fortune-sheet-overlay")
        }

        expect "context-menu-is-visible" {
            visible = css(".workspace-context-menu")
        }

        expect "first-action-receives-focus" {
            visible = css(".workspace-context-menu button[role='menuitem']:focus")
        }

        accessibility "phone-context-menu-accessibility" {
            path = "evidence/spreadsheet-phone-context-menu.json"
            interactive = true
        }

        screenshot "phone-context-menu" {
            path = "screenshots/spreadsheet-phone-context-menu.png"
        }

        press "dismiss-context-menu" {
            key = "Escape"
        }

        expect "grid-focus-restored" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
