suite "office-spreadsheet-ribbon-alignment" {
    version = 1

    scenario "use-wps-aligned-spreadsheet-ribbon" {
        name = "Use the WPS-aligned Spreadsheet command layout"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-ribbon-alignment"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        expect "quick-access-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-quick-access[role='toolbar']")
        }

        expect "undo-shortcut-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-quick-access button[aria-keyshortcuts='Control+Z Meta+Z']")
        }

        expect "redo-shortcut-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-quick-access button[aria-keyshortcuts='Control+Shift+Z Meta+Shift+Z Control+Y Meta+Y']")
        }

        expect "home-clipboard-group-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) .work-office-ribbon-group[aria-label='剪贴板']")
        }

        expect "paste-shortcut-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) button[aria-label='粘贴'][aria-keyshortcuts='Control+V Meta+V']")
        }

        expect "cut-shortcut-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) button[aria-label='剪切'][aria-keyshortcuts='Control+X Meta+X']")
        }

        expect "copy-shortcut-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) button[aria-label='复制'][aria-keyshortcuts='Control+C Meta+C']")
        }

        expect "format-painter-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) button[aria-label='格式刷'][aria-pressed='false']")
        }

        expect "strikethrough-shortcut-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) button[aria-label='删除线'][aria-keyshortcuts='Control+5 Meta+5'][aria-pressed='false']")
        }

        press "toggle-strikethrough-from-grid" {
            key = "Control+5"
        }

        expect "strikethrough-is-active" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) button[aria-label='删除线'][aria-pressed='true']")
        }

        press "restore-strikethrough-from-grid" {
            key = "Control+5"
        }

        expect "strikethrough-is-restored" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) button[aria-label='删除线'][aria-pressed='false']")
        }

        click "activate-one-shot-format-painter" {
            target = role("button", "格式刷")
        }

        expect "one-shot-format-painter-active" {
            visible = css(".work-spreadsheet-editor[data-format-painter='once'] button[aria-label='格式刷'][aria-pressed='true']")
        }

        press "apply-one-shot-format-painter" {
            key = "ArrowRight"
        }

        expect "one-shot-format-painter-complete" {
            visible = css(".work-spreadsheet-editor:not([data-format-painter]) button[aria-label='格式刷'][aria-pressed='false']")
        }

        double_click "lock-format-painter" {
            target = css("button[aria-label='格式刷']")
        }

        expect "locked-format-painter-active" {
            visible = css(".work-spreadsheet-editor[data-format-painter='locked'] button[aria-label='格式刷'][aria-pressed='true']")
        }

        press "apply-locked-format-painter" {
            key = "ArrowDown"
        }

        expect "locked-format-painter-remains-active" {
            visible = css(".work-spreadsheet-editor[data-format-painter='locked'] button[aria-label='格式刷'][aria-pressed='true']")
        }

        press "exit-format-painter" {
            key = "Escape"
        }

        expect "format-painter-exited" {
            visible = css(".work-spreadsheet-editor:not([data-format-painter]) button[aria-label='格式刷'][aria-pressed='false']")
        }

        expect "conditional-formatting-is-on-home" {
            visible = css(".work-spreadsheet-ribbon [role='tab'][data-tab-id='home'][aria-selected='true']")
        }

        expect "home-styles-command-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) .work-office-ribbon-group[aria-label='样式'] button[aria-label^='条件格式']")
        }

        click "open-data" {
            target = css(".work-spreadsheet-ribbon [role='tab'][data-tab-id='data']")
        }

        expect "ascending-sort-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) button[aria-label='升序']")
        }

        expect "descending-sort-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) button[aria-label='降序']")
        }

        click "open-formulas" {
            target = css(".work-spreadsheet-ribbon [role='tab'][data-tab-id='formulas']")
        }

        expect "f9-recalculation-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-panel:not([hidden]) button[aria-keyshortcuts='F9']")
        }

        press "recalculate-workbook" {
            key = "F9"
        }

        double_click "collapse-formulas-ribbon" {
            target = css(".work-spreadsheet-ribbon [role='tab'][data-tab-id='formulas']")
        }

        expect "ribbon-collapsed" {
            visible = css(".work-spreadsheet-ribbon[data-collapsed='true'] .work-office-ribbon-collapse[aria-expanded='false']")
        }

        click "temporarily-open-data" {
            target = css(".work-spreadsheet-ribbon [role='tab'][data-tab-id='data']")
        }

        expect "temporary-data-panel-open" {
            visible = css(".work-spreadsheet-ribbon[data-collapsed='true'] .work-office-ribbon-panel:not([hidden]) button[aria-label='升序']")
        }

        click "return-to-grid" {
            target = css(".fortune-sheet-overlay")
        }

        expect "temporary-panel-closed" {
            visible = css(".work-spreadsheet-ribbon[data-collapsed='true'] .work-office-ribbon-collapse[aria-expanded='false']")
        }

        accessibility "spreadsheet-ribbon-accessibility" {
            path = "evidence/accessibility.json"
            interactive = true
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }

    scenario "use-wps-autofilter-from-grid" {
        name = "Use WPS AutoFilter toggle and header menu habits"
        surface = "web"
        timeout_ms = 120000

        viewport "compact" {
            width = 768
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-ribbon-alignment"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        click "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "select-sheet-start" {
            key = "Control+Home"
        }

        press "select-second-row" {
            key = "ArrowDown"
        }

        press "select-table-header" {
            key = "ArrowDown"
        }

        click "open-data-tab" {
            target = css(".work-spreadsheet-ribbon [role='tab'][data-tab-id='data']")
        }

        expect "autofilter-command-visible" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='自动筛选'][aria-keyshortcuts='Control+Shift+L Meta+Shift+L']")
        }

        click "enable-autofilter" {
            target = role("button", "自动筛选")
        }

        expect "autofilter-active" {
            visible = css(".work-spreadsheet-editor[data-auto-filter='active'] button[aria-label='自动筛选'][aria-pressed='true']")
        }

        expect "status-filter-trigger-visible" {
            visible = css(".luckysheet-filter-options[role='button'][aria-label='状态 筛选'][aria-haspopup='dialog']")
        }

        press "disable-autofilter-by-shortcut" {
            key = "Control+Shift+L"
        }

        expect "autofilter-disabled" {
            visible = css(".work-spreadsheet-editor:not([data-auto-filter]) button[aria-label='自动筛选'][aria-pressed='false']")
        }

        press "enable-autofilter-by-shortcut" {
            key = "Control+Shift+L"
        }

        press "select-income-header" {
            key = "ArrowRight"
        }

        press "select-january-header" {
            key = "ArrowRight"
        }

        press "select-february-header" {
            key = "ArrowRight"
        }

        press "select-march-header" {
            key = "ArrowRight"
        }

        press "select-progress-header" {
            key = "ArrowRight"
        }

        press "select-status-header" {
            key = "ArrowRight"
        }

        press "open-status-filter-menu" {
            key = "Alt+ArrowDown"
        }

        expect "status-filter-dialog-visible" {
            visible = css(".fortune-filter-menu[role='dialog'][aria-label='状态 筛选']")
        }

        expect "filter-search-labeled" {
            visible = css(".fortune-filter-menu input[aria-label='搜索筛选值']")
        }

        press "close-filter-dialog" {
            key = "Escape"
        }

        expect "filter-dialog-closed" {
            visible = css(".luckysheet-filter-options[aria-label='状态 筛选'][aria-expanded='false']")
        }

        accessibility "spreadsheet-autofilter-accessibility" {
            path = "evidence/autofilter-accessibility.json"
            interactive = true
        }

        console "autofilter-browser-console" {
            path = "diagnostics/autofilter-console.json"
            clear = false
        }

        page_errors "autofilter-browser-errors" {
            path = "diagnostics/autofilter-page-errors.json"
            clear = false
        }
    }

    scenario "use-wps-freeze-panes-from-view" {
        name = "Use WPS Freeze Panes from the View window group"
        surface = "web"
        timeout_ms = 120000

        viewport "compact" {
            width = 768
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-ribbon-alignment"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        click "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "select-sheet-start" {
            key = "Control+Home"
        }

        press "select-row-two" {
            key = "ArrowDown"
        }

        press "select-row-three" {
            key = "ArrowDown"
        }

        press "select-b3" {
            key = "ArrowRight"
        }

        click "open-view-tab" {
            target = css(".work-spreadsheet-ribbon [role='tab'][data-tab-id='view']")
        }

        expect "freeze-panes-command-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-group[aria-label='窗口'] button[aria-label='冻结窗格'][aria-haspopup='menu']")
        }

        click "open-freeze-panes-menu" {
            target = role("button", "冻结窗格")
        }

        expect "custom-freeze-boundary-visible" {
            visible = css("[role='menu'][aria-label='冻结窗格选项'] button[role='menuitem']:first-child")
        }

        click "freeze-at-current-cell" {
            target = role("menuitem", "冻结至第 2 行、A 列")
        }

        expect "freeze-panes-active" {
            visible = css(".work-spreadsheet-editor[data-freeze-panes='active'] button[aria-label='冻结窗格'][aria-pressed='true']")
        }

        click "reopen-freeze-panes-menu" {
            target = role("button", "冻结窗格")
        }

        expect "unfreeze-command-visible" {
            visible = css("[role='menu'][aria-label='冻结窗格选项'] button[role='menuitem']:first-child")
        }

        press "focus-last-freeze-command" {
            key = "End"
        }

        expect "last-freeze-command-focused" {
            visible = css("[role='menu'][aria-label='冻结窗格选项'] button[role='menuitem']:last-child:focus")
        }

        press "focus-unfreeze-command" {
            key = "Home"
        }

        press "unfreeze-panes" {
            key = "Enter"
        }

        expect "freeze-panes-inactive" {
            visible = css(".work-spreadsheet-editor:not([data-freeze-panes]) button[aria-label='冻结窗格'][aria-pressed='false']")
        }

        accessibility "spreadsheet-freeze-panes-accessibility" {
            path = "evidence/freeze-panes-accessibility.json"
            interactive = true
        }

        console "freeze-panes-browser-console" {
            path = "diagnostics/freeze-panes-console.json"
            clear = false
        }

        page_errors "freeze-panes-browser-errors" {
            path = "diagnostics/freeze-panes-page-errors.json"
            clear = false
        }
    }

    scenario "use-wps-rows-and-columns-from-home" {
        name = "Use WPS row and column actions from the Home cells group"
        surface = "web"
        timeout_ms = 120000

        viewport "compact" {
            width = 768
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-ribbon-alignment"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "select-sheet-start" {
            key = "Control+Home"
        }

        press "select-row-two" {
            key = "ArrowDown"
        }

        press "select-row-three" {
            key = "ArrowDown"
        }

        press "select-customer-report" {
            key = "ArrowDown"
        }

        expect "customer-report-cell-selected" {
            text = "A4"
        }

        expect "rows-and-columns-command-visible" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-group[aria-label='单元格'] button[aria-label='行和列'][aria-haspopup='menu']")
        }

        click "open-rows-and-columns-menu" {
            target = role("button", "行和列")
        }

        expect "rows-and-columns-menu-visible" {
            visible = css("[role='menu'][aria-label='行和列选项']")
        }

        focus "focus-first-row-command" {
            target = css("[role='menu'][aria-label='行和列选项'] button[role='menuitem']:first-child")
        }

        expect "insert-above-focused" {
            visible = css("[role='menu'][aria-label='行和列选项'] button[role='menuitem']:first-child:focus")
        }

        press "insert-row-above" {
            key = "Enter"
        }

        expect "inserted-row-selected" {
            text = "A4:L4"
        }

        expect "grid-focus-restored-after-insert" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        click "reopen-rows-and-columns-menu" {
            target = role("button", "行和列")
        }

        click "delete-inserted-row" {
            target = role("menuitem", "删除所选行")
        }

        expect "customer-report-cell-restored" {
            text = "A4"
        }

        expect "customer-report-content-restored" {
            text = "客户洞察报告"
        }

        expect "grid-focus-restored-after-delete" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        accessibility "spreadsheet-rows-and-columns-accessibility" {
            path = "evidence/rows-and-columns-accessibility.json"
            interactive = true
        }

        console "rows-and-columns-browser-console" {
            path = "diagnostics/rows-and-columns-console.json"
            clear = false
        }

        page_errors "rows-and-columns-browser-errors" {
            path = "diagnostics/rows-and-columns-page-errors.json"
            clear = false
        }
    }

    scenario "use-wps-merge-from-home" {
        name = "Use WPS merge commands from the Home alignment group"
        surface = "web"
        timeout_ms = 120000

        viewport "compact" {
            width = 768
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-ribbon-alignment"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "create-worksheet" {
            key = "Shift+F11"
        }

        fill "enter-merge-content" {
            target = css("[aria-label='当前单元格输入']")
            value = "North"
        }

        press "commit-merge-content" {
            key = "Enter"
        }

        press "return-to-content" {
            key = "ArrowUp"
        }

        press "extend-selection-to-b1" {
            key = "Shift+ArrowRight"
        }

        press "extend-selection-to-c1" {
            key = "Shift+ArrowRight"
        }

        press "extend-selection-to-c2" {
            key = "Shift+ArrowDown"
        }

        expect "merge-range-selected" {
            text = "A1:C2"
        }

        expect "merge-and-center-is-in-alignment" {
            visible = css(".work-spreadsheet-ribbon .work-office-ribbon-group[aria-label='对齐'] button[aria-label='合并居中'][aria-keyshortcuts='Control+M']")
        }

        click "merge-and-center" {
            target = role("button", "合并居中")
        }

        expect "grid-focus-restored-after-merge" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        click "open-merge-menu" {
            target = role("button", "更多合并方式")
        }

        expect "merge-menu-visible" {
            visible = css("[role='menu'][aria-label='合并选项']")
        }

        expect "unmerge-and-fill-enabled" {
            visible = css("[role='menu'][aria-label='合并选项'] button[role='menuitem']:last-child:not(:disabled)")
        }

        press "focus-unmerge-and-fill" {
            key = "End"
        }

        expect "unmerge-and-fill-focused" {
            visible = css("[role='menu'][aria-label='合并选项'] button[role='menuitem']:last-child:focus")
        }

        press "unmerge-and-fill" {
            key = "Enter"
        }

        expect "grid-focus-restored-after-unmerge" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        press "select-sheet-start" {
            key = "Control+Home"
        }

        press "select-filled-cell" {
            key = "ArrowRight"
        }

        expect "filled-cell-selected" {
            text = "B1"
        }

        expect "filled-cell-content-retained" {
            text = "North"
        }

        accessibility "spreadsheet-merge-accessibility" {
            path = "evidence/merge-accessibility.json"
            interactive = true
        }

        console "merge-browser-console" {
            path = "diagnostics/merge-console.json"
            clear = false
        }

        page_errors "merge-browser-errors" {
            path = "diagnostics/merge-page-errors.json"
            clear = false
        }
    }

    scenario "use-wps-cell-borders-from-home" {
        name = "Apply and undo WPS cell borders from the Home font group"
        surface = "web"
        timeout_ms = 120000

        viewport "compact" {
            width = 768
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-ribbon-alignment"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "select-sheet-start" {
            key = "Control+Home"
        }

        press "extend-selection-to-b1" {
            key = "Shift+ArrowRight"
        }

        press "extend-selection-to-c1" {
            key = "Shift+ArrowRight"
        }

        press "extend-selection-to-c2" {
            key = "Shift+ArrowDown"
        }

        expect "border-range-selected" {
            text = "A1:C2"
        }

        expect "border-dialog-trigger-visible" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='更多框线'][aria-haspopup='dialog']")
        }

        click "open-border-dialog" {
            target = role("button", "更多框线")
        }

        expect "border-dialog-visible" {
            visible = css("[role='dialog'][aria-label='框线设置']")
        }

        expect "first-border-target-focused" {
            visible = css("[role='menu'][aria-label='框线位置'] button[role='menuitemradio']:first-child:focus")
        }

        select "choose-thick-border" {
            target = css("select[aria-label='框线样式']")
            values = ["thick"]
        }

        fill "choose-red-border" {
            target = css("[aria-label='框线颜色']")
            value = "#b42318"
        }

        click "apply-outside-border" {
            target = role("menuitemradio", "外侧框线")
        }

        expect "grid-focus-restored-after-border" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        expect "border-command-is-undoable" {
            visible = css(".work-office-quick-access button[aria-label='撤销']:not(:disabled)")
        }

        click "undo-border" {
            target = role("button", "撤销")
        }

        expect "grid-focus-restored-after-border-undo" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        accessibility "spreadsheet-cell-borders-accessibility" {
            path = "evidence/cell-borders-accessibility.json"
            interactive = true
        }

        console "cell-borders-browser-console" {
            path = "diagnostics/cell-borders-console.json"
            clear = false
        }

        page_errors "cell-borders-browser-errors" {
            path = "diagnostics/cell-borders-page-errors.json"
            clear = false
        }
    }

    scenario "use-wps-clear-from-home" {
        name = "Use WPS Clear modes from the Home editing group"
        surface = "web"
        timeout_ms = 120000

        viewport "compact" {
            width = 768
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-ribbon-alignment"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "create-worksheet" {
            key = "Shift+F11"
        }

        fill "enter-content" {
            target = css("[aria-label='当前单元格输入']")
            value = "Keep style"
        }

        press "commit-content" {
            key = "Enter"
        }

        press "return-to-content" {
            key = "ArrowUp"
        }

        click "apply-bold" {
            target = role("button", "加粗")
        }

        click "open-clear-menu" {
            target = role("button", "清除")
        }

        expect "clear-menu-visible" {
            visible = css("[role='menu'][aria-label='清除选项']")
        }

        expect "clear-all-visible" {
            visible = css("[role='menu'][aria-label='清除选项'] button[role='menuitem']:nth-of-type(1)")
        }

        expect "clear-formats-visible" {
            visible = css("[role='menu'][aria-label='清除选项'] button[role='menuitem']:nth-of-type(2)")
        }

        expect "clear-contents-visible" {
            visible = css("[role='menu'][aria-label='清除选项'] button[role='menuitem']:nth-of-type(3)")
        }

        expect "clear-comments-visible" {
            visible = css("[role='menu'][aria-label='清除选项'] button[role='menuitem']:nth-of-type(4)")
        }

        expect "clear-hyperlinks-visible" {
            visible = css("[role='menu'][aria-label='清除选项'] button[role='menuitem']:nth-of-type(5)")
        }

        focus "focus-first-clear-command" {
            target = css("[role='menu'][aria-label='清除选项'] button[role='menuitem']:first-child")
        }

        expect "clear-all-focused" {
            visible = css("[role='menu'][aria-label='清除选项'] button[role='menuitem']:first-child:focus")
        }

        expect "clear-contents-shortcuts-visible" {
            visible = css("[role='menu'][aria-label='清除选项'] button[role='menuitem'][aria-keyshortcuts='Delete Backspace']")
        }

        press "focus-clear-hyperlinks" {
            key = "End"
        }

        expect "clear-hyperlinks-focused" {
            visible = css("[role='menu'][aria-label='清除选项'] button[role='menuitem']:last-child:focus")
        }

        click "clear-contents" {
            target = role("menuitem", "清除内容")
        }

        expect "grid-focus-restored-after-clear-contents" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        expect "bold-format-retained" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='加粗'][aria-pressed='true']")
        }

        fill "enter-retained-content" {
            target = css("[aria-label='当前单元格输入']")
            value = "Keep value"
        }

        press "commit-retained-content" {
            key = "Enter"
        }

        press "return-to-retained-content" {
            key = "ArrowUp"
        }

        click "reopen-clear-menu" {
            target = role("button", "清除")
        }

        click "clear-formats" {
            target = role("menuitem", "清除格式")
        }

        expect "content-retained-after-clear-formats" {
            text = "Keep value"
        }

        expect "bold-format-cleared" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='加粗'][aria-pressed='false']")
        }

        accessibility "spreadsheet-clear-accessibility" {
            path = "evidence/clear-accessibility.json"
            interactive = true
        }

        console "clear-browser-console" {
            path = "diagnostics/clear-console.json"
            clear = false
        }

        page_errors "clear-browser-errors" {
            path = "diagnostics/clear-page-errors.json"
            clear = false
        }
    }
}
