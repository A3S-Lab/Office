suite "office-spreadsheet-rich-text" {
    version = 1

    scenario "format-every-native-rich-text-run" {
        name = "Render and format every native Spreadsheet rich-text run"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-rich-text-fixture" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-rich-text"
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "native-runs-are-present" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='1'][data-run-count='3'][data-run-bold='1,0,0'][data-run-text='Native rich text']")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "open-font-format" {
            key = "Control+Shift+F"
        }

        expect "font-dialog-open" {
            visible = css(".work-spreadsheet-format-cells-dialog [role='tab'][data-tab-id='font'][aria-selected='true']")
        }

        click "enable-bold" {
            target = css(".work-spreadsheet-format-cells-dialog input[type='checkbox'][aria-label='加粗']")
        }

        click "apply-font-format" {
            target = text("应用", true)
        }

        expect "every-run-is-bold-in-one-update" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='2'][data-run-count='3'][data-run-bold='1,1,1'][data-run-text='Native rich text']")
        }

        expect "grid-focus-restored" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        screenshot "spreadsheet-rich-text" {
            path = "screenshots/spreadsheet-rich-text.png"
        }

        accessibility "spreadsheet-rich-text-accessibility" {
            path = "evidence/accessibility.json"
            interactive = true
        }

        console "spreadsheet-rich-text-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "spreadsheet-rich-text-page-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }

    scenario "format-selected-native-rich-text-run" {
        name = "Format only selected Spreadsheet rich text and restore focus"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-rich-text-selection-fixture" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-rich-text"
        }

        wait "rich-text-selection-ready" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='1'][data-run-count='3'][data-run-bold='1,0,0']")
        }

        focus "focus-formula-bar" {
            target = css(".fortune-fx-input")
        }

        press "move-to-start" {
            key = "Home"
        }

        press "move-to-r-1" {
            key = "ArrowRight"
        }

        press "move-to-r-2" {
            key = "ArrowRight"
        }

        press "move-to-r-3" {
            key = "ArrowRight"
        }

        press "move-to-r-4" {
            key = "ArrowRight"
        }

        press "move-to-r-5" {
            key = "ArrowRight"
        }

        press "move-to-r-6" {
            key = "ArrowRight"
        }

        press "move-to-r-7" {
            key = "ArrowRight"
        }

        press "select-rich-1" {
            key = "Shift+ArrowRight"
        }

        press "select-rich-2" {
            key = "Shift+ArrowRight"
        }

        press "select-rich-3" {
            key = "Shift+ArrowRight"
        }

        press "select-rich-4" {
            key = "Shift+ArrowRight"
        }

        click "bold-selected-rich-text" {
            target = role("button", "加粗")
        }

        expect "only-selected-run-is-bold" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='2'][data-run-count='4'][data-run-bold='1,1,0,0'][data-run-text='Native rich text']")
        }

        expect "formula-bar-focus-restored" {
            visible = css(".fortune-fx-input:focus")
        }

        screenshot "spreadsheet-selected-rich-text" {
            path = "screenshots/spreadsheet-selected-rich-text.png"
        }

        accessibility "spreadsheet-selected-rich-text-accessibility" {
            path = "evidence/accessibility.json"
            interactive = true
        }

        console "spreadsheet-selected-rich-text-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "spreadsheet-selected-rich-text-page-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }

    scenario "edit-native-rich-text-in-formula-bar" {
        name = "Insert and delete native Spreadsheet rich text in the formula bar"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-rich-text-edit-fixture" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-rich-text"
        }

        wait "rich-text-edit-ready" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='1'][data-run-count='3'][data-run-origins='theme,indexed,automatic'][data-run-text='Native rich text']")
        }

        focus "focus-rich-text-formula-bar" {
            target = css(".fortune-fx-input")
        }

        press "move-edit-to-start" {
            key = "Home"
        }

        press "move-edit-right-1" {
            key = "ArrowRight"
        }

        press "move-edit-right-2" {
            key = "ArrowRight"
        }

        press "move-edit-right-3" {
            key = "ArrowRight"
        }

        type "insert-inside-theme-run" {
            target = css(".fortune-fx-input")
            value = "X"
        }

        expect "draft-does-not-publish-early" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='1'][data-run-text='Native rich text']")
        }

        press "commit-rich-text-insertion" {
            key = "Enter"
        }

        expect "insertion-keeps-native-runs-and-origins" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='2'][data-run-count='3'][data-run-bold='1,0,0'][data-run-origins='theme,indexed,automatic'][data-run-text='NatXive rich text'][data-cell-text='NatXive rich text']")
        }

        press "return-to-edited-rich-text-cell" {
            key = "ArrowUp"
        }

        focus "refocus-rich-text-formula-bar" {
            target = css(".fortune-fx-input")
        }

        press "move-delete-to-end" {
            key = "End"
        }

        press "delete-automatic-run-character" {
            key = "Backspace"
        }

        expect "delete-draft-does-not-publish-early" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='2'][data-run-text='NatXive rich text']")
        }

        press "commit-rich-text-deletion" {
            key = "Enter"
        }

        expect "deletion-keeps-native-runs-and-origins" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='3'][data-run-count='3'][data-run-origins='theme,indexed,automatic'][data-run-text='NatXive rich tex'][data-cell-text='NatXive rich tex']")
        }

        press "undo-rich-text-deletion" {
            key = "Control+z"
        }

        expect "one-undo-restores-the-prior-rich-text-value" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='4'][data-run-count='3'][data-run-origins='theme,indexed,automatic'][data-run-text='NatXive rich text']")
        }

        screenshot "spreadsheet-rich-text-edit" {
            path = "screenshots/spreadsheet-rich-text-edit.png"
        }

        accessibility "spreadsheet-rich-text-edit-accessibility" {
            path = "evidence/accessibility.json"
            interactive = true
        }

        console "spreadsheet-rich-text-edit-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "spreadsheet-rich-text-edit-page-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }

    scenario "paste-formatted-rich-text-in-formula-bar" {
        name = "Paste authenticated formatted text into a native Spreadsheet rich-text run"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-formatted-paste-fixture" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-rich-text"
        }

        wait "formatted-paste-ready" {
            text = "复制格式示例"
        }

        click "copy-formatted-sample" {
            target = role("button", "复制格式示例")
        }

        expect "formatted-sample-copied" {
            text = "带格式文本已复制"
        }

        focus "focus-formula-bar-for-formatted-paste" {
            target = css(".fortune-fx-input")
        }

        press "formatted-paste-to-start" {
            key = "Home"
        }

        press "formatted-paste-to-rich-1" {
            key = "ArrowRight"
        }

        press "formatted-paste-to-rich-2" {
            key = "ArrowRight"
        }

        press "formatted-paste-to-rich-3" {
            key = "ArrowRight"
        }

        press "formatted-paste-to-rich-4" {
            key = "ArrowRight"
        }

        press "formatted-paste-to-rich-5" {
            key = "ArrowRight"
        }

        press "formatted-paste-to-rich-6" {
            key = "ArrowRight"
        }

        press "formatted-paste-to-rich-7" {
            key = "ArrowRight"
        }

        press "select-rich-for-paste-1" {
            key = "Shift+ArrowRight"
        }

        press "select-rich-for-paste-2" {
            key = "Shift+ArrowRight"
        }

        press "select-rich-for-paste-3" {
            key = "Shift+ArrowRight"
        }

        press "select-rich-for-paste-4" {
            key = "Shift+ArrowRight"
        }

        click "paste-formatted-sample" {
            target = role("button", "粘贴格式示例")
        }

        expect "formatted-sample-pasted" {
            text = "带格式文本已粘贴"
        }

        expect "formatted-paste-draft-visible" {
            text = "Native Styled text"
        }

        press "commit-formatted-paste" {
            key = "Enter"
        }

        expect "formatted-paste-keeps-every-supported-run-style" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='2'][data-run-count='4'][data-run-bold='1,1,0,0'][data-run-italic='0,1,1,0'][data-run-colors='#2f6fed,#c00000,#159469,#000000'][data-run-fonts='Aptos Display,Georgia,Georgia,none'][data-run-sizes='14,16,12,none'][data-run-underline='0,2,0,2'][data-run-origins='theme,none,indexed,automatic'][data-run-text='Native Styled text']")
        }

        press "undo-formatted-paste" {
            key = "Control+z"
        }

        expect "one-undo-restores-native-runs" {
            visible = css("[data-testid='spreadsheet-rich-text-status'][data-revision='3'][data-run-count='3'][data-run-origins='theme,indexed,automatic'][data-run-text='Native rich text']")
        }

        screenshot "spreadsheet-formatted-rich-text-paste" {
            path = "screenshots/spreadsheet-formatted-rich-text-paste.png"
        }

        accessibility "spreadsheet-formatted-rich-text-paste-accessibility" {
            path = "evidence/accessibility.json"
            interactive = true
        }

        console "spreadsheet-formatted-rich-text-paste-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "spreadsheet-formatted-rich-text-paste-page-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
