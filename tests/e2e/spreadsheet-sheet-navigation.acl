suite "office-spreadsheet-sheet-navigation" {
    version = 1

    scenario "switch-sheets-with-wps-ctrl-pageup-pagedown" {
        name = "Switch worksheets with WPS Ctrl+PageUp / Ctrl+PageDown"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/?e2e=spreadsheet-ribbon-alignment"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "sheet-bar-shortcuts" {
            visible = css(".work-spreadsheet-sheet-bar button[aria-label='下一个工作表'][aria-keyshortcuts='Control+PageDown Meta+PageDown']")
        }

        expect "first-sheet-selected" {
            visible = css(".work-spreadsheet-sheet-bar [role='tab'][title='执行看板'][aria-selected='true']")
        }

        click "create-second-sheet" {
            target = role("button", "新建工作表")
        }

        wait "second-sheet-active" {
            visible = css(".work-spreadsheet-sheet-bar [role='tab'][title='工作表 2'][aria-selected='true']")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "previous-sheet" {
            key = "Control+PageUp"
        }

        expect "first-sheet-active" {
            visible = css(".work-spreadsheet-sheet-bar [role='tab'][title='执行看板'][aria-selected='true']")
        }

        expect "grid-keeps-focus" {
            visible = css(".fortune-sheet-overlay:focus")
        }

        press "next-sheet" {
            key = "Control+PageDown"
        }

        expect "second-sheet-active-again" {
            visible = css(".work-spreadsheet-sheet-bar [role='tab'][title='工作表 2'][aria-selected='true']")
        }

        accessibility "sheet-navigation-accessibility" {
            path = "evidence/sheet-navigation-accessibility.json"
            interactive = true
        }

        console "sheet-navigation-console" {
            path = "diagnostics/sheet-navigation-console.json"
            clear = false
        }

        page_errors "sheet-navigation-page-errors" {
            path = "diagnostics/sheet-navigation-page-errors.json"
            clear = false
        }
    }
}
