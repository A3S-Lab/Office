suite "office-spreadsheet-table-totals" {
    version = 1

    scenario "author-and-edit-totals-row" {
        name = "Author and edit a native Spreadsheet totals row"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        wait "playground-ready" {
            visible = css(".playground-template-section")
        }

        click "open-structured-reference-template" {
            target = css("button[data-template-id='structured-references']")
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        expect "template-title-visible" {
            visible = css("input[aria-label='文件名'][value='结构化引用示例']")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "select-table-header" {
            key = "Control+Home"
        }

        press "move-to-table" {
            key = "ArrowDown"
        }

        press "move-to-table-body" {
            key = "ArrowDown"
        }

        expect "table-design-tab-visible" {
            visible = css(".work-spreadsheet-ribbon [role='tab'][aria-selected='true'][data-contextual='true']")
        }

        click "open-totals-menu" {
            target = role("button", "汇总行")
        }

        expect "totals-menu-visible" {
            visible = css("[role='dialog'][aria-label='表格汇总行设置']")
        }

        expect "totals-enabled" {
            visible = css("[role='dialog'][aria-label='表格汇总行设置'] .work-office-checkbox.checked:has(input[aria-label='启用汇总行'])")
        }

        expect "units-sum-selected" {
            visible = css("[role='dialog'][aria-label='表格汇总行设置'] [role='combobox'][aria-label='Units 汇总函数'][data-selected-value='sum']")
        }

        click "open-units-function" {
            target = role("combobox", "Units 汇总函数")
        }

        click "change-units-function" {
            target = role("option", "平均值")
        }

        wait "units-average-ready" {
            visible = css("[role='dialog'][aria-label='表格汇总行设置'] [role='combobox'][aria-label='Units 汇总函数'][data-selected-value='average']")
        }

        expect "units-average-selected" {
            visible = css("[role='dialog'][aria-label='表格汇总行设置'] [role='combobox'][aria-label='Units 汇总函数'][data-selected-value='average']")
        }

        click "open-revenue-function" {
            target = role("combobox", "Revenue 汇总函数")
        }

        click "choose-custom-function" {
            target = role("option", "自定义")
        }

        wait "custom-formula-ready" {
            visible = css("[role='dialog'][aria-label='表格汇总行设置'] input[aria-label='Revenue 汇总公式']:not([disabled])")
        }

        expect "custom-formula-visible" {
            visible = css("[role='dialog'][aria-label='表格汇总行设置'] input[aria-label='Revenue 汇总公式']:not([disabled])")
        }

        click "close-totals-menu" {
            target = role("button", "完成")
        }

        expect "totals-menu-closed" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='汇总行'][aria-pressed='true']")
        }

        accessibility "spreadsheet-table-totals-accessibility" {
            path = "evidence/spreadsheet-table-totals-accessibility.json"
            interactive = true
        }

        console "spreadsheet-table-totals-console" {
            path = "diagnostics/spreadsheet-table-totals-console.json"
            clear = false
        }

        page_errors "spreadsheet-table-totals-page-errors" {
            path = "diagnostics/spreadsheet-table-totals-page-errors.json"
            clear = false
        }
    }
}
