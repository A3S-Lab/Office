suite "office-spreadsheet-underline-styles" {
    version = 1

    scenario "use-advanced-underline-styles" {
        name = "Use advanced underline styles from the Spreadsheet ribbon"
        surface = "web"
        timeout_ms = 120000

        viewport "compact" {
            width = 768
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=spreadsheet-underline-styles"
        }

        wait "spreadsheet-artifact-ready" {
            visible = css(".playground-artifact-card.spreadsheet")
        }

        click "open-spreadsheet" {
            target = text("季度执行计划", true)
        }

        wait "spreadsheet-ready" {
            visible = css(".work-spreadsheet-editor .fortune-sheet-overlay")
        }

        focus "focus-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "create-worksheet" {
            key = "Shift+F11"
        }

        fill "enter-value" {
            target = css("[aria-label='当前单元格输入']")
            value = "A3S underline"
        }

        press "commit-value" {
            key = "Enter"
        }

        press "return-to-value" {
            key = "ArrowUp"
        }

        expect "underline-shortcut-visible" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='下划线'][aria-keyshortcuts='Control+U Meta+U Control+4'][aria-pressed='false']")
        }

        click "open-underline-menu" {
            target = role("button", "更多下划线")
        }

        expect "underline-menu-visible" {
            visible = css("[role='menu'][aria-label='下划线样式']")
        }

        expect "none-style-focused" {
            visible = css("[role='menu'][aria-label='下划线样式'] [role='menuitemradio'][aria-label='无下划线']:focus")
        }

        click "apply-double-accounting" {
            target = role("menuitemradio", "双会计用下划线")
        }

        expect "double-accounting-active" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='下划线'][aria-pressed='true'][title='下划线（双会计用下划线；Cmd/Ctrl+U 或 Ctrl+4）']")
        }

        screenshot "double-accounting-underline" {
            path = "screenshots/spreadsheet-double-accounting-underline.png"
        }

        focus "return-to-grid" {
            target = css(".fortune-sheet-overlay")
        }

        press "toggle-underline-off" {
            key = "Control+u"
        }

        expect "underline-disabled" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='下划线'][aria-pressed='false'][title='下划线（无下划线；Cmd/Ctrl+U 或 Ctrl+4）']")
        }

        press "undo-toggle" {
            key = "Control+z"
        }

        expect "double-accounting-restored" {
            visible = css(".work-spreadsheet-ribbon button[aria-label='下划线'][aria-pressed='true'][title='下划线（双会计用下划线；Cmd/Ctrl+U 或 Ctrl+4）']")
        }

        accessibility "underline-accessibility" {
            path = "evidence/underline-accessibility.json"
            interactive = true
        }

        console "underline-console" {
            path = "diagnostics/underline-console.json"
            clear = false
        }

        page_errors "underline-page-errors" {
            path = "diagnostics/underline-page-errors.json"
            clear = false
        }
    }
}
