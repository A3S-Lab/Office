suite "office-word-citations-phone" {
    version = 1

    scenario "validate-save-and-insert-citation-on-phone" {
        name = "Validate, save, and insert a Word citation from the phone task pane"
        surface = "web"
        timeout_ms = 30000

        viewport "phone" {
            width = 390
            height = 844
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/?e2e=word-citations-phone"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-document" {
            target = text("项目方案", true)
        }

        wait "document-loaded" {
            text = "记录尚未解决的问题、依赖和决策负责人。"
        }

        click "open-references-tab" {
            target = role("tab", "引用")
        }

        click "show-more-reference-tools" {
            target = role("button", "向右查看更多引用工具")
        }

        wait "references-ribbon-ready" {
            text = "文献库"
        }

        click "open-citation-library" {
            target = role("button", "文献库")
        }

        wait "citation-form-ready" {
            text = "新建文献"
        }

        fill "enter-citation-tag" {
            target = css("input[aria-label='文献简称']")
            value = "Agentic2026"
        }

        expect "incomplete-source-can-be-submitted" {
            visible = css("button[aria-label='保存文献']:not(:disabled)")
        }

        click "save-incomplete-source" {
            target = role("button", "保存文献")
        }

        expect "title-error-is-inline" {
            text = "请输入文献标题。"
        }

        expect "invalid-title-receives-focus" {
            visible = css("input[aria-label='文献标题'][aria-invalid='true'][aria-describedby]:focus")
        }

        expect "error-is-associated-with-title" {
            visible = css("input[aria-label='文献标题'][aria-invalid='true'] + .work-office-dialog-field-error[role='alert']")
        }

        screenshot "inline-title-validation" {
            path = "screenshots/word-citation-title-validation-phone.png"
        }

        fill "enter-citation-title" {
            target = css("input[aria-label='文献标题']")
            value = "Agentic Office Workflows"
        }

        expect "valid-source-can-be-submitted" {
            visible = css("button[aria-label='保存文献']:not(:disabled)")
        }

        click "save-valid-source" {
            target = role("button", "保存文献")
        }

        expect "source-is-saved" {
            text = "Agentic2026 · 无年份"
        }

        click "insert-citation" {
            target = role("button", "插入引文")
        }

        click "close-citation-library" {
            target = role("button", "关闭文献库")
        }

        expect "citation-is-in-document" {
            text = "(Agentic Office Workflows, n.d.)"
        }

        expect "library-invoker-focus-is-restored" {
            visible = css(".work-office-ribbon-group[aria-label='文献'] button[aria-label='文献库（1）']:focus")
        }

        accessibility "citation-semantics" {
            path = "evidence/citation-semantics.json"
            interactive = true
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
