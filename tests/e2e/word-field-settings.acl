suite "office-word-field-settings" {
    version = 1

    scenario "insert-formatted-page-field" {
        name = "Insert a typed WPS-compatible page field from the settings dialog"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/?e2e=word-field-settings"
        }

        wait "document-loaded" {
            visible = css(".work-document-editable .ProseMirror[data-pagination-state='ready']")
        }

        click "open-insert-tab" {
            target = role("tab", "插入")
        }

        click "open-field-settings" {
            target = role("button", "字段设置")
        }

        wait "field-dialog" {
            visible = css(".work-document-field-dialog")
        }

        expect "field-type-is-page" {
            visible = css(".ds-dialog.work-document-field-dialog [role='combobox'][aria-label='字段类型']")
        }

        click "open-numeric-format" {
            target = role("combobox", "数字格式")
        }

        click "choose-lower-roman" {
            target = role("option", "小写罗马数字（i）")
        }

        expect "preview-is-lower-roman" {
            visible = css("[role='dialog'][aria-label='插入字段'] [role='status']:has-text('i')")
        }

        click "insert-field" {
            target = role("button", "插入字段")
        }

        expect "formatted-page-field-is-live" {
            visible = css(".work-document-field[data-field-kind='page'][data-field-display='i']")
        }

        press "refresh-field" {
            key = "F9"
        }

        expect "document-focus-is-restored" {
            visible = css(".work-document-editable .ProseMirror:focus")
        }

        screenshot "field-settings" {
            path = "screenshots/word-field-settings.png"
        }

        accessibility "field-settings-accessibility" {
            path = "evidence/word-field-settings-accessibility.json"
            interactive = true
        }

        console "field-settings-console" {
            path = "diagnostics/word-field-settings-console.json"
            clear = false
        }

        page_errors "field-settings-page-errors" {
            path = "diagnostics/word-field-settings-page-errors.json"
            clear = false
        }
    }

    scenario "insert-formatted-page-field-on-phone" {
        name = "Keep field settings usable in the compact Writer ribbon"
        surface = "web"
        timeout_ms = 120000

        viewport "phone" {
            width = 390
            height = 844
            scale = 1
        }

        navigate "open-compact-playground" {
            url = "http://127.0.0.1:4175/playground/?e2e=word-field-settings"
        }

        wait "compact-document-loaded" {
            visible = css(".work-document-editable .ProseMirror[data-pagination-state='ready']")
        }

        click "open-compact-insert-tab" {
            target = role("tab", "插入")
        }

        click "show-compact-insert-tools" {
            target = role("button", "向右查看更多插入工具")
        }

        click "show-compact-insert-tools-again" {
            target = role("button", "向右查看更多插入工具")
        }

        wait "compact-field-button" {
            visible = css("button[aria-label='字段设置']")
        }

        click "open-compact-field-settings" {
            target = css("button[aria-label='字段设置']")
        }

        wait "compact-field-dialog" {
            visible = css(".work-document-field-dialog")
        }

        expect "compact-dialog-is-contained" {
            visible = css(".work-document-field-dialog")
        }

        screenshot "field-settings-phone" {
            path = "screenshots/word-field-settings-phone.png"
        }

        accessibility "field-settings-phone-accessibility" {
            path = "evidence/word-field-settings-phone-accessibility.json"
            interactive = true
        }

        console "field-settings-phone-console" {
            path = "diagnostics/word-field-settings-phone-console.json"
            clear = false
        }

        page_errors "field-settings-phone-page-errors" {
            path = "diagnostics/word-field-settings-phone-page-errors.json"
            clear = false
        }
    }
}
