suite "office-word-kerning" {
    version = 1

    scenario "author-and-clear-native-kerning" {
        name = "Author and clear a native Writer kerning threshold"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-document" {
            target = text("项目方案", true)
        }

        wait "document-loaded" {
            visible = css(".work-document-editable .ProseMirror")
        }

        expect "font-dialog-shortcut-described" {
            visible = css("[aria-label='字体'] button[aria-label='字体高级设置'][aria-keyshortcuts='Control+D Meta+D']")
        }

        click "focus-title" {
            target = css(".work-document-editable .ProseMirror h1")
        }

        press "move-to-title-start" {
            key = "Home"
        }

        press "select-title" {
            key = "Shift+End"
        }

        press "open-font-dialog" {
            key = "Control+d"
        }

        wait "font-dialog-visible" {
            visible = css(".work-document-font-dialog[role='dialog']")
        }

        expect "kerning-disabled-by-default" {
            visible = css(".work-document-font-dialog [aria-label='字距调整阈值（磅）']:disabled")
        }

        click "enable-kerning" {
            target = css(".work-document-font-dialog input[type='checkbox'][aria-label='为字号达到以下值的字体调整字距']")
        }

        fill "set-ten-point-threshold" {
            target = css(".work-document-font-dialog [aria-label='字距调整阈值（磅）']")
            value = "10"
        }

        expect "effective-kerning-preview" {
            visible = css(".work-document-font-dialog [aria-label='字符高级格式预览'] output[style*='font-kerning: normal']")
        }

        click "apply-kerning" {
            target = role("button", "应用")
        }

        expect "native-kerning-applied" {
            visible = css(".work-document-editable .ProseMirror h1 span[data-office-kerning-threshold-half-points='20'][style*='font-kerning: normal']")
        }

        expect "editor-focus-restored" {
            visible = css(".work-document-editable .ProseMirror:focus")
        }

        press "reopen-font-dialog" {
            key = "Control+d"
        }

        wait "font-dialog-reopened" {
            visible = css(".work-document-font-dialog[role='dialog']")
        }

        wait "kerning-checkbox-restored" {
            visible = css(".work-document-font-dialog input[aria-label='为字号达到以下值的字体调整字距']:checked")
        }

        click "clear-direct-kerning" {
            target = css(".work-document-font-dialog input[type='checkbox'][aria-label='为字号达到以下值的字体调整字距']")
        }

        expect "disabled-threshold-after-clear" {
            visible = css(".work-document-font-dialog [aria-label='字距调整阈值（磅）']:disabled")
        }

        expect "disabled-kerning-preview" {
            visible = css(".work-document-font-dialog [aria-label='字符高级格式预览'] output[style*='font-kerning: none']")
        }

        click "apply-clear" {
            target = role("button", "应用")
        }

        expect "direct-kerning-cleared" {
            visible = css(".work-document-editable .ProseMirror h1:not(:has(span[data-office-kerning-threshold-half-points]))")
        }

        press "undo-clear" {
            key = "Control+z"
        }

        expect "single-step-undo-restores-threshold" {
            visible = css(".work-document-editable .ProseMirror h1 span[data-office-kerning-threshold-half-points='20'][style*='font-kerning: normal']")
        }

        accessibility "kerning-accessibility" {
            path = "evidence/kerning-accessibility.json"
            interactive = true
        }

        console "kerning-console" {
            path = "diagnostics/kerning-console.json"
            clear = false
        }

        page_errors "kerning-page-errors" {
            path = "diagnostics/kerning-page-errors.json"
            clear = false
        }
    }
}
