suite "office-word-move-block-shortcuts" {
    version = 1

    scenario "move-writer-paragraphs-with-wps-alt-shift-arrows" {
        name = "Move Writer paragraphs with WPS Alt+Shift+ArrowUp / ArrowDown"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-document" {
            target = text("项目方案", true)
        }

        wait "document-loaded" {
            visible = css(".work-document-editable .ProseMirror")
        }

        click "select-scope-heading" {
            target = text("工作范围", true)
        }

        press "move-to-heading-start" {
            key = "Home"
        }

        press "move-block-up" {
            key = "Alt+Shift+ArrowUp"
        }

        expect "scope-moved-above-background" {
            text = "工作范围"
        }

        press "move-block-down" {
            key = "Alt+Shift+ArrowDown"
        }

        expect "scope-restored" {
            text = "工作范围"
        }

        expect "editor-focus-restored" {
            visible = css(".work-document-editable .ProseMirror:focus")
        }

        accessibility "word-move-block-shortcuts-accessibility" {
            path = "evidence/word-move-block-shortcuts-accessibility.json"
        }

        console "word-move-block-shortcuts-console" {
            path = "diagnostics/word-move-block-shortcuts-console.json"
        }

        page_errors "word-move-block-shortcuts-page-errors" {
            path = "diagnostics/word-move-block-shortcuts-page-errors.json"
        }
    }
}
