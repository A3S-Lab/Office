suite "office-word-notes-phone" {
    version = 1

    scenario "renumber-delete-and-restore-a-footnote-on-phone" {
        name = "Keep paired Word footnotes numbered and undoable on a phone"
        surface = "web"
        timeout_ms = 30000

        viewport "phone" {
            width = 390
            height = 844
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/?e2e=word-notes-phone"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-document" {
            target = text("项目方案", true)
        }

        wait "document-loaded" {
            text = "明确不在本期范围内的事项"
        }

        focus "focus-document-end" {
            target = css(".work-document-editable .ProseMirror")
        }

        press "move-to-document-end" {
            key = "Control+End"
        }

        click "open-references-tab" {
            target = role("tab", "引用")
        }

        click "insert-later-footnote" {
            target = role("button", "插入脚注")
        }

        type "write-later-footnote" {
            target = css(".work-document-note[data-note-number='1'] p")
            value = "末尾脚注"
        }

        focus "return-to-document" {
            target = css(".work-document-editable .ProseMirror")
        }

        click "place-caret-at-document-start" {
            target = css(".work-document-editable .ProseMirror h1")
        }

        press "move-to-document-start" {
            key = "Control+Home"
        }

        click "insert-earlier-footnote" {
            target = role("button", "插入脚注")
        }

        type "write-earlier-footnote" {
            target = css(".work-document-note[data-note-number='1'] p")
            value = "开头脚注"
        }

        wait "document-is-mounted-after-renumber" {
            visible = css(".work-document-editable .ProseMirror")
        }

        expect "references-and-definitions-renumber-together" {
            visible = css(".work-document-editable .ProseMirror:has(sup[data-document-note-reference][data-note-number='1']):has(sup[data-document-note-reference][data-note-number='2']):has(aside[data-document-note][data-note-number='1']):has(aside[data-document-note][data-note-number='2'])")
        }

        click "select-earlier-reference" {
            target = css("sup[data-document-note-reference][data-note-number='1']")
        }

        press "delete-earlier-reference" {
            key = "Delete"
        }

        expect "reference-and-definition-delete-as-one-pair" {
            visible = css(".work-document-editable .ProseMirror:has(sup[data-document-note-reference][data-note-number='1']):has(aside[data-document-note][data-note-number='1']):not(:has(sup[data-document-note-reference][data-note-number='2'])):not(:has(aside[data-document-note][data-note-number='2']))")
        }

        press "undo-paired-deletion" {
            key = "Control+Z"
        }

        expect "undo-restores-both-numbered-pairs" {
            visible = css(".work-document-editable .ProseMirror:has(sup[data-document-note-reference][data-note-number='1']):has(sup[data-document-note-reference][data-note-number='2']):has(aside[data-document-note][data-note-number='1']):has(aside[data-document-note][data-note-number='2']):focus")
        }

        screenshot "paired-footnotes-restored" {
            path = "screenshots/word-notes-phone.png"
        }

        accessibility "note-semantics" {
            path = "evidence/word-notes-phone.json"
            interactive = true
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
