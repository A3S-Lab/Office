suite "office-word-paragraph-layout-phone" {
    version = 1

    scenario "format-word-paragraph-on-phone" {
        name = "Format Word paragraph spacing and pagination from phone popovers"
        surface = "web"
        timeout_ms = 30000

        viewport "phone" {
            width = 390
            height = 844
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=word-paragraph-layout-phone"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-document" {
            target = text("项目方案", true)
        }

        wait "document-loaded" {
            text = "负责人：项目团队"
        }

        click "open-page-layout" {
            target = role("tab", "页面布局")
        }

        click "open-paragraph-spacing" {
            target = role("button", "段落间距")
        }

        expect "spacing-dialog-is-ready" {
            visible = css(".work-document-paragraph-spacing-panel[role='dialog'][aria-label='段落间距选项']")
        }

        fill "set-space-before" {
            target = label("段前间距（磅）")
            value = "12"
        }

        press "commit-space-before" {
            key = "Enter"
        }

        expect "space-before-is-committed" {
            visible = css(".ProseMirror [data-office-space-before='12']")
        }

        press "close-paragraph-spacing" {
            key = "Escape"
        }

        expect "spacing-focus-is-restored" {
            visible = css("button[aria-label='段落间距'][aria-expanded='false']:focus")
        }

        click "open-paragraph-pagination" {
            target = role("button", "段落分页")
        }

        expect "pagination-dialog-is-ready" {
            visible = css(".work-document-pagination-panel[role='dialog'][aria-label='段落分页选项']")
        }

        check "keep-paragraph-together" {
            target = label("段落不跨页")
        }

        expect "keep-lines-is-committed" {
            visible = css(".ProseMirror [data-office-keep-lines='true']")
        }

        press "close-paragraph-pagination" {
            key = "Escape"
        }

        expect "pagination-focus-is-restored" {
            visible = css("button[aria-label='段落分页'][aria-expanded='false']:focus")
        }

        accessibility "paragraph-layout-semantics" {
            path = "evidence/paragraph-layout-semantics.json"
            interactive = true
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
