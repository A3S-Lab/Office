suite "office-word-picture-properties-phone" {
    version = 1

    scenario "edit-picture-properties-and-restore-focus" {
        name = "Edit Word picture size, layout, and alternative text as one phone workflow"
        surface = "web"
        timeout_ms = 30000

        viewport "phone" {
            width = 390
            height = 844
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-document" {
            target = css(".playground-artifact-card.document")
        }

        wait "document-loaded" {
            text = "负责人：项目团队"
        }

        click "place-picture" {
            target = css(".work-document-editable .ProseMirror p")
        }

        upload "insert-picture" {
            target = css("input[aria-label='插入文档图片']")
            paths = [".a3s-test/fixtures/word-picture.png"]
        }

        wait "picture-inserted" {
            visible = css(".work-document-editable [data-resize-container][data-node='image'] img[alt='word-picture.png']")
        }

        click "scroll-picture-tools-once" {
            target = role("button", "向右查看更多图片工具")
        }

        click "scroll-picture-tools-twice" {
            target = role("button", "向右查看更多图片工具")
        }

        click "open-picture-properties" {
            target = role("button", "图片属性")
        }

        expect "picture-properties-dialog-ready" {
            visible = css("[role='dialog'][aria-labelledby]")
        }

        fill "set-picture-width" {
            target = label("图片宽度（厘米）")
            value = "5"
        }

        uncheck "unlock-picture-aspect-ratio" {
            target = css("[role='dialog'] input[aria-label='锁定纵横比']")
        }

        fill "set-picture-height" {
            target = label("图片高度（厘米）")
            value = "3"
        }

        click "use-tight-wrapping" {
            target = css("[role='dialog'] input[name='picture-properties-layout'][value='tight'] + span")
        }

        click "open-wrap-side" {
            target = role("combobox", "图片文字环绕侧")
        }

        click "use-largest-wrap-side" {
            target = role("option", "较宽一侧")
        }

        click "align-picture-right" {
            target = css("[role='dialog'] input[name='picture-properties-alignment'][value='right'] + span")
        }

        fill "set-picture-text-distance" {
            target = label("图片与文字距离（毫米）")
            value = "8"
        }

        fill "set-picture-layer" {
            target = label("图片绘图层级顺序")
            value = "50331648"
        }

        check "place-picture-behind-text" {
            target = css("[role='dialog'] input[aria-label='图片衬于文字下方']")
        }

        check "allow-picture-overlap" {
            target = css("[role='dialog'] input[aria-label='允许图片重叠']")
        }

        uncheck "disable-cell-layout" {
            target = css("[role='dialog'] input[aria-label='图片随表格单元格布局']")
        }

        check "lock-picture-anchor" {
            target = css("[role='dialog'] input[aria-label='锁定图片锚点']")
        }

        fill "describe-picture" {
            target = label("图片替代文字")
            value = "Blue project diagram"
        }

        click "apply-picture-properties" {
            target = role("button", "确定")
        }

        expect "picture-properties-saved" {
            visible = css(".work-document-editable [data-resize-container][data-node='image'][data-office-image-layout='tight'][data-office-image-wrap-side='largest'][data-office-image-wrap-polygon-edited='false'][data-office-image-alignment='right'][data-office-image-wrap-distance='8'][data-office-image-lock-aspect-ratio='false'][data-office-image-relative-height='50331648'][data-office-image-behind-document='true'][data-office-image-allow-overlap='true'][data-office-image-layout-in-cell='false'][data-office-image-lock-anchor='true'] img[alt='Blue project diagram'][width='189'][height='113']")
        }

        expect "picture-selection-retained" {
            visible = css(".work-document-editable [data-resize-container][data-node='image'].ProseMirror-selectednode")
        }

        expect "picture-properties-invoker-focused" {
            visible = css(".work-office-ribbon-group[aria-label='图片'] button[aria-label='图片属性']:focus")
        }

        press "reopen-from-restored-focus" {
            key = "Enter"
        }

        expect "picture-properties-dialog-reopened" {
            visible = css("[role='dialog'][aria-labelledby]")
        }

        click "cancel-reopened-dialog" {
            target = role("button", "取消")
        }

        expect "invoker-focus-restored-after-cancel" {
            visible = css(".work-office-ribbon-group[aria-label='图片'] button[aria-label='图片属性']:focus")
        }

        press "open-properties-for-free-floating" {
            key = "Enter"
        }

        expect "free-floating-dialog-ready" {
            visible = css("[role='dialog'][aria-labelledby]")
        }

        click "use-free-floating-layout" {
            target = css("[role='dialog'] input[name='picture-properties-layout'][value='none'] + span")
        }

        expect "free-floating-disables-wrap-controls" {
            visible = css("[role='dialog'] input[aria-label='图片与文字距离（毫米）']:disabled")
        }

        click "apply-free-floating-layout" {
            target = role("button", "确定")
        }

        expect "free-floating-layout-saved" {
            visible = css(".work-document-editable [data-resize-container][data-node='image'][data-office-image-layout='none'][data-office-image-behind-document='true'] img[alt='Blue project diagram']")
        }

        screenshot "picture-properties-phone" {
            path = "screenshots/word-picture-properties-phone.png"
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
