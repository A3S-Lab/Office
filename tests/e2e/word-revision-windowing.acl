suite "office-word-revision-windowing" {
    version = 1

    scenario "review-a-120-revision-word-document" {
        name = "Keep long Word revision review bounded and keyboard reachable"
        surface = "web"
        timeout_ms = 60000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=word-revision-windowing"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        upload "open-long-review-document" {
            target = css("input[aria-label='打开 Office 或 PDF 文件']")
            paths = [".a3s-test/fixtures/word-revisions-120.docx"]
        }

        wait "long-review-document-loaded" {
            text = "Deterministic revision marker 001"
        }

        click "open-review-tab" {
            target = role("tab", "审阅")
        }

        expect "revision-count-ready" {
            visible = css("button[aria-label='查看修订（120）']")
        }

        click "open-revision-review" {
            target = role("button", "查看修订（120）")
        }

        wait "windowed-revision-list-ready" {
            visible = css(".work-document-change-list[data-document-change-count='120'][data-document-change-windowed='true']")
        }

        expect "revision-mounting-is-bounded" {
            visible = css(".work-document-change-list[data-document-change-count='120']:not([data-document-change-mounted-count='120'])")
        }

        focus "focus-first-revision" {
            target = css("button[aria-label='定位修订 1']")
        }

        press "focus-last-revision" {
            key = "End"
        }

        expect "last-revision-is-focused" {
            visible = css("[data-document-change-item='120'] button[aria-label='定位修订 120']:focus")
        }

        expect "leading-review-distance-is-preserved" {
            visible = css("[data-document-change-spacer='before'], [data-document-change-spacer='between']")
        }

        press "move-to-last-accept-action" {
            key = "Tab"
        }

        expect "last-accept-action-is-focused" {
            visible = css("button[aria-label='接受修订 120']:focus")
        }

        press "accept-last-revision" {
            key = "Enter"
        }

        wait "review-count-updated" {
            visible = css(".work-document-change-list[data-document-change-count='119']")
        }

        expect "decision-focus-follows-the-next-review" {
            visible = css("button[aria-label='接受修订 119']:focus")
        }

        press "return-to-last-summary" {
            key = "Shift+Tab"
        }

        expect "last-summary-is-focused" {
            visible = css("button[aria-label='定位修订 119']:focus")
        }

        press "return-to-first-revision" {
            key = "Home"
        }

        expect "first-revision-is-focused" {
            visible = css("[data-document-change-item='1'] button[aria-label='定位修订 1']:focus")
        }

        expect "trailing-review-distance-is-preserved" {
            visible = css("[data-document-change-spacer='after'], [data-document-change-spacer='between']")
        }

        screenshot "bounded-revision-review" {
            path = "screenshots/word-revision-windowing.png"
        }

        accessibility "bounded-revision-tree" {
            path = "evidence/word-revision-windowing.json"
            interactive = true
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
