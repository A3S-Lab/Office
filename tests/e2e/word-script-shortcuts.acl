suite "office-word-script-shortcuts" {
    version = 1

    scenario "toggle-writer-sub-and-superscript-with-wps-shortcuts" {
        name = "Toggle Writer subscript and superscript with WPS shortcuts"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-document" {
            target = text("项目方案", true)
        }

        wait "document-loaded" {
            visible = css(".work-document-editable .ProseMirror")
        }

        expect "subscript-shortcut-described" {
            visible = css("[aria-label='字体'] button[aria-label='下标'][aria-keyshortcuts='Control+= Meta+=']")
        }

        expect "superscript-shortcut-described" {
            visible = css("[aria-label='字体'] button[aria-label='上标'][aria-keyshortcuts='Control+Shift+= Meta+Shift+=']")
        }

        click "select-title" {
            target = css(".work-document-editable .ProseMirror h1")
        }

        press "move-to-title-start" {
            key = "Home"
        }

        press "select-title-line" {
            key = "Shift+End"
        }

        press "apply-subscript" {
            key = "Control+="
        }

        expect "subscript-applied" {
            visible = css(".work-document-editable .ProseMirror h1 sub")
        }

        expect "subscript-command-active" {
            visible = css("[aria-label='字体'] button[aria-label='下标'][aria-pressed='true']")
        }

        press "apply-superscript" {
            key = "Control+Shift+="
        }

        expect "superscript-applied" {
            visible = css(".work-document-editable .ProseMirror h1 sup")
        }

        expect "subscript-cleared-for-superscript" {
            visible = css(".work-document-editable .ProseMirror h1:not(:has(sub))")
        }

        expect "superscript-command-active" {
            visible = css("[aria-label='字体'] button[aria-label='上标'][aria-pressed='true']")
        }

        expect "editor-focus-restored" {
            visible = css(".work-document-editable .ProseMirror:focus")
        }

        accessibility "word-script-shortcuts-accessibility" {
            path = "evidence/word-script-shortcuts-accessibility.json"
        }

        console "word-script-shortcuts-console" {
            path = "diagnostics/word-script-shortcuts-console.json"
        }

        page_errors "word-script-shortcuts-page-errors" {
            path = "diagnostics/word-script-shortcuts-page-errors.json"
        }
    }
}
