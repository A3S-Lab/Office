suite "office-word-styled-table" {
    version = 1

    scenario "preserve-conditional-table-style" {
        name = "Preserve inherited Word table styles in editing and preview"
        surface = "web"
        timeout_ms = 90000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/?e2e=word-styled-table"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        upload "open-styled-table-document" {
            target = css("input[aria-label='打开 Office 或 PDF 文件']")
            paths = [".a3s-test/fixtures/word-styled-table.docx"]
        }

        wait "document-loaded" {
            text = "Styled report table"
        }

        wait "pagination-ready" {
            visible = css(".work-document-editable .ProseMirror[data-pagination-state='ready']")
        }

        expect "table-geometry-matches-word" {
            visible = css(".work-document-editable table[data-office-table-layout='autofit'][data-office-table-width-type='percent'][data-office-table-width='62.5'][data-office-table-alignment='center'][data-office-table-cell-margin-left='9.6'][data-office-table-cell-margin-right='14.4']")
        }

        expect "cell-margin-override-is-preserved" {
            visible = css(".work-document-editable table tr:first-child td:first-child[data-office-cell-margin-top='8'][data-office-cell-margin-right='16']")
        }

        expect "header-style-is-inherited" {
            visible = css(".work-document-editable table tr:first-child td[data-office-cell-fill='#4472c4'][data-office-cell-border-bottom-color='#ffffff'][data-office-cell-border-bottom-style='double']")
        }

        expect "header-run-is-bold" {
            visible = css(".work-document-editable table tr:first-child td strong")
        }

        expect "header-run-is-white" {
            visible = css(".work-document-editable table tr:first-child td span[style*='#ffffff'], .work-document-editable table tr:first-child td span[style*='rgb(255, 255, 255)']")
        }

        expect "header-paragraph-layout-is-inherited" {
            visible = css(".work-document-editable table tr:first-child td p[style*='text-align: center'][data-office-space-after='0'][data-office-keep-lines='true'][data-office-keep-with-next='true']")
        }

        expect "body-band-is-inherited" {
            visible = css(".work-document-editable table tr:nth-child(2) td[data-office-cell-fill='#f8cbad']")
        }

        expect "body-paragraph-layout-is-inherited" {
            visible = css(".work-document-editable table tr:nth-child(2) td p[data-office-space-after='4'][data-office-keep-lines='true'][data-office-widow-control='true']")
        }

        expect "last-row-style-is-inherited" {
            visible = css(".work-document-editable table tr:nth-child(3) td[data-office-cell-fill='#a5a5a5']")
        }

        expect "last-row-paragraph-layout-is-inherited" {
            visible = css(".work-document-editable table tr:nth-child(3) td p[style*='text-align: right'][data-office-indent-right='12']")
        }

        click "select-table-cell" {
            target = css(".work-document-editable table tr:first-child td:first-child")
        }

        click "open-table-layout" {
            target = role("tab", "表格布局")
        }

        expect "custom-autofit-width-is-truthful" {
            text = "当前宽度"
        }

        click "open-cell-margins" {
            target = role("button", "单元格边距")
        }

        expect "cell-margin-dialog-is-semantic" {
            visible = css("[role='dialog'][aria-label='单元格边距设置'] .work-document-table-margin-field")
        }

        fill "change-left-cell-margin" {
            target = label("单元格左边距（厘米）")
            value = "0.5"
        }

        press "commit-left-cell-margin" {
            key = "Enter"
        }

        wait "left-cell-margin-is-applied" {
            visible = css(".work-document-editable table[data-office-table-cell-margin-left='18.9']")
        }

        screenshot "table-cell-margin-dialog" {
            path = "screenshots/word-table-cell-margins.png"
        }

        press "close-cell-margin-dialog" {
            key = "Escape"
        }

        expect "cell-margin-trigger-regains-focus" {
            visible = css(".work-document-table-margins-popover button[aria-expanded='false']:focus")
        }

        click "open-table-properties" {
            target = role("button", "表格属性")
        }

        expect "imported-preferred-width-is-percent" {
            visible = css(".work-document-table-properties-dialog label:has(input[type='radio'][value='percent']:checked) > span")
        }

        expect "imported-preferred-width-is-truthful" {
            visible = css(".work-document-table-properties-dialog input[aria-label='表格宽度（百分比）'][value='62.5']")
        }

        expect "imported-table-alignment-is-center" {
            visible = css(".work-document-table-properties-dialog label:has(input[type='radio'][value='center']:checked) > span")
        }

        expect "current-width-type-receives-focus" {
            visible = css(".work-document-table-properties-dialog label:has(input[type='radio'][value='percent']:checked:focus) > span")
        }

        viewport "compact-table-properties" {
            width = 390
            height = 844
            scale = 1
        }

        expect "compact-width-steppers-are-available" {
            visible = css(".work-document-table-properties-dialog button[aria-label='增加表格宽度（百分比）']")
        }

        screenshot "compact-table-properties-dialog" {
            path = "screenshots/word-table-properties-phone.png"
        }

        fill "change-table-width" {
            target = label("表格宽度（百分比）")
            value = "72"
        }

        click "align-table-left" {
            target = css(".work-document-table-properties-dialog label:has(input[type='radio'][value='left'])")
        }

        fill "change-table-indent" {
            target = label("表格左缩进（厘米）")
            value = "0.5"
        }

        click "apply-table-properties" {
            target = role("button", "确定")
        }

        wait "table-properties-are-applied-atomically" {
            visible = css(".work-document-editable table[data-office-table-width-type='percent'][data-office-table-width='72'][data-office-table-alignment='left'][data-office-table-indent='18.9']")
        }

        expect "table-properties-trigger-regains-focus" {
            visible = css(".work-office-ribbon-group[aria-label='表格属性'] button[aria-label='表格属性']:focus")
        }

        click "reopen-table-properties-for-cancel" {
            target = role("button", "表格属性")
        }

        fill "draft-cancelled-table-width" {
            target = label("表格宽度（百分比）")
            value = "80"
        }

        click "cancel-table-properties" {
            target = role("button", "取消")
        }

        expect "cancel-keeps-committed-table-properties" {
            visible = css(".work-document-editable table[data-office-table-width='72'][data-office-table-alignment='left'][data-office-table-indent='18.9']")
        }

        expect "cancel-restores-table-properties-trigger" {
            visible = css(".work-office-ribbon-group[aria-label='表格属性'] button[aria-label='表格属性']:focus")
        }

        click "reopen-table-properties-for-escape" {
            target = role("button", "表格属性")
        }

        fill "draft-escaped-table-width" {
            target = label("表格宽度（百分比）")
            value = "84"
        }

        press "escape-table-properties" {
            key = "Escape"
        }

        expect "escape-keeps-committed-table-properties" {
            visible = css(".work-document-editable table[data-office-table-width='72'][data-office-table-alignment='left'][data-office-table-indent='18.9']")
        }

        expect "escape-restores-table-properties-trigger" {
            visible = css(".work-office-ribbon-group[aria-label='表格属性'] button[aria-label='表格属性']:focus")
        }

        viewport "restore-desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        click "preview-document" {
            target = role("button", "预览")
        }

        expect "preview-keeps-header-style" {
            visible = css(".work-document-preview-page table tr:first-child td[data-office-cell-fill='#4472c4'][data-office-cell-border-bottom-color='#ffffff'] strong")
        }

        expect "preview-keeps-body-band" {
            visible = css(".work-document-preview-page table tr:nth-child(2) td[data-office-cell-fill='#f8cbad']")
        }

        expect "preview-keeps-last-row-style" {
            visible = css(".work-document-preview-page table tr:nth-child(3) td[data-office-cell-fill='#a5a5a5']")
        }

        expect "preview-keeps-table-geometry" {
            visible = css(".work-document-preview-page table[data-office-table-layout='autofit'][data-office-table-width-type='percent'][data-office-table-width='72'][data-office-table-alignment='left'][data-office-table-indent='18.9'][data-office-table-cell-margin-left='18.9']")
        }

        expect "preview-keeps-cell-margin-override" {
            visible = css(".work-document-preview-page table tr:first-child td:first-child[data-office-cell-margin-top='8'][data-office-cell-margin-right='16']")
        }

        expect "preview-keeps-header-paragraph-layout" {
            visible = css(".work-document-preview-page table tr:first-child td p[style*='text-align: center'][data-office-space-after='0'][data-office-keep-lines='true'][data-office-keep-with-next='true']")
        }

        expect "preview-keeps-body-paragraph-layout" {
            visible = css(".work-document-preview-page table tr:nth-child(2) td p[data-office-space-after='4'][data-office-keep-lines='true'][data-office-widow-control='true']")
        }

        expect "preview-keeps-last-row-paragraph-layout" {
            visible = css(".work-document-preview-page table tr:nth-child(3) td p[style*='text-align: right'][data-office-indent-right='12']")
        }

        screenshot "styled-table-preview" {
            path = "screenshots/word-styled-table-preview.png"
        }

        accessibility "styled-table-semantics" {
            path = "evidence/word-styled-table.json"
            interactive = true
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
