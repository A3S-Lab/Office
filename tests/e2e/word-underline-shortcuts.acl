suite "office-word-underline-shortcuts" {
    version = 1

    scenario "apply-wps-double-and-words-underline-shortcuts" {
        name = "Apply Writer double and words underline with WPS shortcuts"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-document" {
            target = text("项目方案", true)
        }

        wait "document-loaded" {
            visible = css(".work-document-editable .ProseMirror")
        }

        click "open-underline-menu" {
            target = css("[aria-label='字体'] button[aria-label='更多下划线']")
        }

        expect "double-underline-shortcut-described" {
            visible = css("[role='menu'][aria-label='下划线样式'] [role='menuitemradio'][aria-label='双下划线'][aria-keyshortcuts='Control+Shift+D Meta+Shift+D']")
        }

        expect "words-underline-shortcut-described" {
            visible = css("[role='menu'][aria-label='下划线样式'] [role='menuitemradio'][aria-label='仅字下划线'][aria-keyshortcuts='Control+Shift+W Meta+Shift+W']")
        }

        press "close-underline-menu" {
            key = "Escape"
        }

        click "select-title" {
            target = css(".work-document-editable .ProseMirror h1")
        }

        press "move-to-title-start" {
            key = "Home"
        }

        press "select-title-line" {
            key = "Shift+End"
        }

        press "apply-double-underline" {
            key = "Control+Shift+d"
        }

        expect "double-underline-applied" {
            visible = css(".work-document-editable .ProseMirror h1 [data-office-underline-style='double'][style*='text-decoration-style: double']")
        }

        press "apply-words-underline" {
            key = "Control+Shift+w"
        }

        expect "words-underline-applied" {
            visible = css(".work-document-editable .ProseMirror h1 [data-office-underline-style='words']")
        }

        accessibility "word-underline-shortcuts-accessibility" {
            path = "evidence/word-underline-shortcuts-accessibility.json"
        }

        console "word-underline-shortcuts-console" {
            path = "diagnostics/word-underline-shortcuts-console.json"
        }

        page_errors "word-underline-shortcuts-page-errors" {
            path = "diagnostics/word-underline-shortcuts-page-errors.json"
        }
    }
}
