suite "office-word-wps-connector-boundary" {
    version = 1

    scenario "edit-wps-vml-connector-boundary" {
        name = "Import a WPS VML connector as a bounded editable straight line"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/playground/"
        }

        upload "import-wps-connector" {
            target = css("input[aria-label='打开 Office 或 PDF 文件']")
            paths = [".a3s-test/fixtures/word-wps-connector.docx"]
        }

        wait "document-loaded" {
            visible = css(".work-document-editable .ProseMirror[data-pagination-state='ready']")
        }

        expect "connector-is-visible" {
            visible = css(".work-document-editable .ProseMirror [data-document-connector]")
        }

        expect "connector-is-not-a-text-box" {
            visible = css(".work-document-editable .ProseMirror:not(:has([data-document-text-box]))")
        }

        click "select-connector" {
            target = css(".work-document-editable [data-document-connector]")
        }

        expect "connector-contextual-tab" {
            visible = css("[role='tab'][aria-selected='true']")
        }

        expect "connector-import-keeps-editor-usable" {
            visible = css(".work-document-editable .ProseMirror[contenteditable='true']")
        }

        screenshot "wps-connector-editable" {
            path = "screenshots/word-wps-connector-editable.png"
        }

        accessibility "wps-connector-editable-accessibility" {
            path = "evidence/word-wps-connector-editable-accessibility.json"
            interactive = true
        }

        console "wps-connector-editable-console" {
            path = "diagnostics/word-wps-connector-editable-console.json"
            clear = false
        }

        page_errors "wps-connector-editable-page-errors" {
            path = "diagnostics/word-wps-connector-editable-page-errors.json"
            clear = false
        }
    }
}
