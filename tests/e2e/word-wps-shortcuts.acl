suite "office-word-wps-shortcuts" {
    version = 1

    scenario "execute-wps-writer-shortcuts-inside-the-document" {
        name = "Execute WPS Writer formatting and review shortcuts"
        surface = "web"
        timeout_ms = 120000

        viewport "desktop" {
            width = 1280
            height = 800
            scale = 1
        }

        navigate "open-playground" {
            url = "http://127.0.0.1:4175/"
        }

        expect "playground-ready" {
            text = "我的文档"
        }

        click "open-document" {
            target = text("项目方案", true)
        }

        wait "document-loaded" {
            visible = css(".work-document-editable .ProseMirror")
        }

        expect "format-copy-shortcuts-described" {
            visible = css("[aria-label='剪贴板'] button[aria-label='复制格式'][aria-keyshortcuts='Control+Shift+C Meta+Shift+C']")
        }

        click "select-format-source" {
            target = css(".work-document-editable .ProseMirror h1")
        }

        press "move-to-source-start" {
            key = "Home"
        }

        press "select-format-source-line" {
            key = "Shift+End"
        }

        press "italicize-format-source" {
            key = "Control+i"
        }

        press "copy-source-format" {
            key = "Control+Shift+c"
        }

        click "select-format-target" {
            target = css(".work-document-editable .ProseMirror p")
        }

        press "move-to-target-start" {
            key = "Home"
        }

        press "select-format-target-line" {
            key = "Shift+End"
        }

        press "paste-source-format" {
            key = "Control+Shift+v"
        }

        expect "format-and-heading-style-pasted" {
            visible = css(".work-document-editable .ProseMirror h1:has(em) ~ h1:has(em)")
        }

        expect "text-case-shortcuts-described" {
            visible = css("[aria-label='字体'] button[aria-label='大小写效果']")
        }

        press "apply-all-caps" {
            key = "Control+Shift+a"
        }

        expect "all-caps-rendered" {
            visible = css(".work-document-editable .ProseMirror h1 ~ h1 span[data-office-text-case='all-caps'][style*='text-transform: uppercase']")
        }

        press "apply-small-caps" {
            key = "Control+Shift+k"
        }

        expect "small-caps-rendered" {
            visible = css(".work-document-editable .ProseMirror h1 ~ h1 span[data-office-text-case='small-caps'][style*='font-variant-caps: small-caps']")
        }

        press "undo-small-caps" {
            key = "Control+z"
        }

        expect "all-caps-restored" {
            visible = css(".work-document-editable .ProseMirror h1 ~ h1 span[data-office-text-case='all-caps']")
        }

        click "focus-first-paragraph" {
            target = css(".work-document-editable .ProseMirror p")
        }

        press "center-paragraph" {
            key = "Control+e"
        }

        expect "paragraph-centered" {
            visible = css(".work-document-editable .ProseMirror p[style*='text-align: center']")
        }

        press "use-single-line-spacing" {
            key = "Control+1"
        }

        expect "single-line-spacing-applied" {
            visible = css(".work-document-editable .ProseMirror p[style*='line-height: 1']")
        }

        press "apply-heading-two" {
            key = "Control+Alt+2"
        }

        expect "heading-two-applied" {
            visible = css(".work-document-editable .ProseMirror h2")
        }

        press "toggle-spellcheck" {
            key = "F7"
        }

        expect "spellcheck-disabled" {
            visible = css("[role='textbox'][aria-label='文档正文'][spellcheck='false']")
        }

        click "refocus-heading" {
            target = css(".work-document-editable .ProseMirror h2")
        }

        press "toggle-track-changes" {
            key = "Control+Shift+e"
        }

        click "open-review-tab" {
            target = role("tab", "审阅")
        }

        expect "review-shortcuts-described" {
            visible = css("button[aria-label='添加批注'][aria-keyshortcuts='Control+Alt+M Meta+Alt+M']")
        }

        expect "track-changes-enabled" {
            visible = css("button[aria-label='修订模式'][aria-keyshortcuts='Control+Shift+E Meta+Shift+E'][aria-pressed='true']")
        }

        accessibility "writer-shortcut-accessibility" {
            path = "evidence/accessibility.json"
            interactive = true
        }

        console "browser-console" {
            path = "diagnostics/console.json"
            clear = false
        }

        page_errors "browser-errors" {
            path = "diagnostics/page-errors.json"
            clear = false
        }
    }
}
