          {
            "row": 0,
            "column": 0,
            "value": { "kind": "number", "value": 4 }
          }
        ]
      },
      {
        "id": "totals",
        "name": "Totals",
        "cells": [
          {
            "row": 0,
            "column": 0,
            "formula": "=Data!A1*3",
            "value": { "kind": "blank" }
          }
        ]
      }
    ],
    "targets": [],
    "expectedCells": [
      {
        "sheetId": "totals",
        "row": 0,
        "column": 0,
        "value": { "kind": "number", "value": 12 }
      }
    ],
    "expectedOrder": [{ "sheetId": "totals", "row": 0, "column": 0 }],
    "expectedIssues": []
  },
